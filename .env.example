# Public (safe in the browser). Read-only: RLS limits it to published items.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_CF_ANALYTICS_TOKEN=
# Pre-launch: true adds noindex so Google skips the site. Sample data also turns it on.
PUBLIC_NOINDEX=
# Visitor tracker (src/components/VisitTracker.astro): the shared Supabase project's URL and publishable key.
# Separate from PUBLIC_SUPABASE_URL on purpose. Empty = no tracking. See docs/visitor-tracking.md
PUBLIC_TRACKER_URL=
PUBLIC_TRACKER_KEY=

# Cloudflare Pages secrets (functions/api/catalog.ts). Never commit.
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DAVID_EMAIL=

# Content pipeline (scripts/sync-content.mjs): Cloudflare R2 for the collection pictures. Empty = public/media (local preview only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ASSET_BASE_URL=
