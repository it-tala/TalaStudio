---
// One card per item of a collection: gallery pictures grouped by caption name, in gallery order.
// A click opens a full-screen viewer for that item: the big picture on top, every angle as a thumbnail strip below.
// Pictures without a caption are left out.
// Wood (and, for upholstered items, fabric) swatches under the picture switch the item to the photos of that finish.
import type { Collection } from '../lib/supabase';
import { edgeBackground, cardFit, photoRatio } from '../lib/edge';
import { swatch, finishSlug } from '../data/finishes';
import { itemSpec } from '../data/item-codes';
import { groupItems } from '../lib/items';
import { atWidth, srcsetOf } from '../lib/content';
// link: "View the collection" under the cards. only: show just these items (by name); the rest stay on the collection page.
interface Props { collection: Collection; link?: boolean; only?: string[] }
const { collection, link = true, only } = Astro.props;
const woods = collection.woods ?? [];
// The finish the default photos show: named in `shown`, else the first of the list
const shownOf = (list: string[]) => list.find((x) => collection.shown?.includes(x)) ?? list[0];
const shownWood = shownOf(woods);
// An item with nothing but its spec sheet (no photo yet) stays off the catalog: the spec sheet is never the card picture
// How much of the 4:3 card each empty band takes (in %), once the photo is shown whole (and zoomed by cardFit)
const bandOf = (ratio: number, scale = 1) => {
  if (!ratio) return { wide: false, tall: false, size: 0 };
  const h = (4 / 3 / ratio) * scale; // photo height as a share of the card's
  const w = ratio / (4 / 3); // photo width as a share of the card's
  if (h < 0.99) return { wide: true, tall: false, size: +((1 - h) * 50).toFixed(2) };
  if (w < 0.99) return { wide: false, tall: true, size: +((1 - w) * 50).toFixed(2) };
  return { wide: false, tall: false, size: 0 };
};
const items = await Promise.all(groupItems(collection).filter((it) => (!only || only.includes(it.name)) && it.pics.some((p) => !p.spec)).map(async ({ name, folder, pics: grouped }) => {
  // Room shots (covers) belong to the card slider, not here, unless an item has nothing else. The card and viewer open on the front view.
  const all = grouped.some((p) => !p.cover) ? grouped.filter((p) => !p.cover) : grouped;
  const pics = [...all.filter((p) => p.front), ...all.filter((p) => !p.front)];
  const srcs = pics.map((p) => p.src);
  const fabrics = collection.upholstered?.includes(name) ? collection.fabrics ?? [] : [];
  const shownFabric = shownOf(fabrics);
  // Photos per finish choice, keyed 'walnut' or 'walnut/grey'. The shown wood (and fabric) uses the default photos.
  // For the shown fabric, a wood-only folder counts too (walnut/ for walnut + cream).
  const photos: Record<string, string[]> = {};
  woods.forEach((w) => (fabrics.length ? fabrics : [undefined]).forEach((f) => {
    const wk = finishSlug(w);
    const key = f ? `${wk}/${finishSlug(f)}` : wk;
    const found = w === shownWood && f === shownFabric ? srcs : pics.flatMap((p) => p.finishes?.[key] ?? (f === shownFabric ? p.finishes?.[wk] : undefined) ?? []);
    if (found.length) photos[key] = found;
  }));
  return { name, folder, srcs, fabrics, shownFabric, photos, bg: await edgeBackground(srcs[0]), fit: await cardFit(srcs[0]), band: bandOf(await photoRatio(srcs[0]), (await cardFit(srcs[0]))?.scale) };
}));
// The viewer shows every photo whole in a square (1:1); the space around it takes the photo's own edge colour
const viewerSrcs = [...new Set(items.flatMap((it) => Object.values(it.photos).flat().concat(it.srcs)))];
const squareBg = Object.fromEntries(await Promise.all(viewerSrcs.map(async (s) => [s, await edgeBackground(s, 1)])));
const id = `cat-${collection.slug}`;
// Under each card: the finish shown, then the item's code number from the line sheet; its size on the line below
const finishLine = (parts: string[], code: string | null) => [...parts, code].filter(Boolean).join(' · ');
const specOf = (it: { name: string; folder: string }) => itemSpec(collection.name, collection.room, it.name, it.folder);
const codeOf = (it: { name: string; folder: string }) => specOf(it)?.code ?? null;
// The spec page at the end of the item viewer (built in the browser from this, see specPage below)
const specData = (it: { name: string; folder: string }) => {
  const s = specOf(it);
  return s && JSON.stringify({
    collection: collection.name, name: it.name, code: s.code, category: s.category, size: s.size, sizeIn: s.sizeIn,
    notes: s.specification, finishes: s.finishes, handle: s.handle,
  });
};
---
{items.length > 0 && (
  <section class="cat" aria-labelledby={`${id}-title`} data-collection={collection.name} data-bgs={JSON.stringify(squareBg)}>
    <div class="tiles-head">
      <p class="eyebrow" id={`${id}-title`} style="margin:0">{collection.name}{collection.room !== 'other' && ` ${collection.room[0].toUpperCase()}${collection.room.slice(1)}`} collection</p>
    </div>
    <ul class="cat-grid">
      {items.map((it) => (
        <li class="cat-item" data-name={it.name} data-code={codeOf(it) ?? undefined} data-desc={specOf(it)?.description ?? undefined} data-spec={specData(it) || undefined} data-srcs={JSON.stringify(it.srcs)} data-photos={JSON.stringify(it.photos)}>
          <button type="button" class="cat-card" aria-haspopup="dialog" aria-label={`View ${it.name}`}>
            <span class:list={['frame', 'edge-fill', { 'fill-wide': it.band.wide, 'fill-tall': it.band.tall }]} style={[it.bg && `background:${it.bg}`, `--fill:url(${atWidth(it.srcs[0], 480)})`, `--band:${it.band.size}%`, it.fit && `--fs:${it.fit.scale};--fx:${it.fit.shift}`].filter(Boolean).join(';')}>
              <img src={it.srcs[0]} srcset={srcsetOf(it.srcs[0])} sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 25vw" alt={`${collection.name} ${it.name}`} loading="lazy" style={it.fit ? `scale:${it.fit.scale};translate:${it.fit.shift}% ${it.fit.shiftY}%` : undefined} />
            </span>
          </button>
          {woods.length > 0 && (
            <div class="cat-swatches">
              <span role="group" aria-label="Wood">
                {woods.map((w) => <button type="button" class="sw" data-wood={finishSlug(w)} data-label={w} aria-pressed={w === shownWood ? 'true' : 'false'} aria-label={w} title={w} style={`--sw:${swatch(w)}`}></button>)}
              </span>
              {it.fabrics.length > 0 && (
                <span role="group" aria-label="Fabric">
                  {it.fabrics.map((f) => <button type="button" class="sw" data-fabric={finishSlug(f)} data-label={f} aria-pressed={f === it.shownFabric ? 'true' : 'false'} aria-label={f} title={f} style={`--sw:${swatch(f)}`}></button>)}
                </span>
              )}
            </div>
          )}
          <span class="cat-name">{it.name}</span>
          <span class="cat-views">{finishLine([shownWood ?? specOf(it)?.finish, it.shownFabric].filter((s): s is string => !!s), codeOf(it))}</span>
          {specOf(it)?.size && <span class="cat-size">{specOf(it)!.size}</span>}
        </li>
      ))}
    </ul>
    {link && <div class="cat-more"><a class="link" style="margin:0" href={`/collections/${collection.slug}`}>View the collection</a></div>}
  </section>
)}

<script>
  import { openViewer } from '../lib/viewer';

  document.querySelectorAll<HTMLElement>('.cat').forEach((sec) => {
    const bgs: Record<string, string | null> = JSON.parse(sec.dataset.bgs ?? '{}');

    // The chosen finish of an item: its photos (the default ones while that finish has none yet) and its names
    const finish = (li: HTMLElement) => {
      const picked = [...li.querySelectorAll<HTMLButtonElement>('.sw[aria-pressed="true"]')];
      const key = picked.map((s) => s.dataset.wood ?? s.dataset.fabric).join('/');
      const own: string[] | undefined = JSON.parse(li.dataset.photos ?? '{}')[key];
      return { srcs: own ?? (JSON.parse(li.dataset.srcs ?? '[]') as string[]), labels: picked.map((s) => s.dataset.label!), soon: picked.length > 0 && !own };
    };
    sec.querySelectorAll<HTMLElement>('.cat-item').forEach((li) => {
      const img = li.querySelector<HTMLImageElement>('.cat-card img')!;
      const views = li.querySelector('.cat-views')!;
      li.querySelectorAll<HTMLButtonElement>('.sw').forEach((sw) => sw.addEventListener('click', () => {
        sw.parentElement!.querySelectorAll('.sw').forEach((o) => o.setAttribute('aria-pressed', String(o === sw)));
        const f = finish(li);
        if (img.src !== new URL(f.srcs[0], location.href).href) img.removeAttribute('srcset');
        img.src = f.srcs[0];
        img.parentElement!.style.setProperty('--fill', `url(${f.srcs[0]})`);
        img.alt = `${sec.dataset.collection} ${li.dataset.name}, ${f.labels.join(', ')}`;
        views.textContent = [...f.labels, f.soon ? 'photo soon' : li.dataset.code].filter(Boolean).join(' · ');
      }));
    });

    sec.querySelectorAll<HTMLButtonElement>('.cat-card').forEach((b) => b.addEventListener('click', () => {
      const li = b.closest<HTMLElement>('.cat-item')!;
      const name = li.dataset.name ?? '';
      const f = finish(li);
      const spec = li.dataset.spec ? specPage(JSON.parse(li.dataset.spec), f.srcs) : null;
      openViewer({
        title: name,
        info: f.soon ? '' : f.labels.join(' · '),
        text: li.dataset.desc,
        opener: b,
        slides: [
          ...f.srcs.map((src, i) => ({ src, bg: bgs[src], alt: `${sec.dataset.collection} ${name}, view ${i + 1} of ${f.srcs.length}` })),
          ...(spec ? [{ src: f.srcs[0], html: spec, alt: `${sec.dataset.collection} ${name}, specification`, info: 'Specification' }] : []),
        ],
      });
    }));
  });

  // The spec page, the viewer's last slide, laid out like the printed spec sheet: the item's photos (front large,
  // perspective and detail beside it, in the finish picked), then its code, category, finishes, hardware, size and notes
  type Swatch = { name: string; swatch: string | null };
  type Spec = { collection: string; name: string; code: string | null; category: string; size: string | null; sizeIn: string | null; notes: string[]; finishes: Swatch[]; handle: Swatch | null };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function specPage(s: Spec, photos: string[]) {
    const rows = [
      ['Product', `${s.collection} ${s.name}`], ['Code', s.code], ['Category', s.category],
      ['Finish', s.finishes.map((f) => f.name).join(', ')], ['Hardware', s.handle?.name],
      ['Size (mm)', s.size?.replace(/ mm$/, '')], ['Size (in)', s.sizeIn?.replace(/ in$/, '')],
    ].filter(([, v]) => v);
    const swatches = [...s.finishes, ...(s.handle ? [s.handle] : [])].filter((f) => f.swatch);
    return `<div class="spec-page">
      <p class="spec-coll">${esc(s.collection)}</p><h4>${esc(s.name)}</h4>
      ${photos.length ? `<div class="spec-photos n${Math.min(photos.length, 3)}">${photos.slice(0, 3).map((p, i) => `<img src="${esc(p)}" alt="${esc(`${s.collection} ${s.name}, view ${i + 1}`)}">`).join('')}</div>` : ''}
      <p class="spec-head">Specification</p>
      <dl>${rows.map(([k, v]) => `<dt>${esc(k!)}</dt><dd>${esc(v!)}</dd>`).join('')}</dl>
      ${swatches.length ? `<ul class="spec-sw">${swatches.map((f) => `<li><span style="background-image:url(${esc(f.swatch!)})"></span>${esc(f.name)}</li>`).join('')}</ul>` : ''}
      ${s.notes.length ? `<p class="spec-head">Notes</p><ul class="spec-notes">${s.notes.map((n) => `<li>${esc(n)}</li>`).join('')}</ul>` : ''}
    </div>`;
  }
</script>

<style is:global>
  /* Edge to edge, lined up with the collection card's text */
  .cat { --cat-edge: clamp(20px, 4vw, 64px); padding-block: clamp(48px, 6vw, 88px) 0; }
  .cat .tiles-head { max-width: none; padding-inline: var(--cat-edge); margin-bottom: 28px; align-items: center; }
  .cat .tiles-head .eyebrow { scroll-margin-top: 6rem; } /* "Explore the collection" lands here, clear of the sticky header */
  .cat-grid { list-style: none; margin: 0; padding: 0 var(--cat-edge); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 20px; }
  .cat-item { display: flex; flex-direction: column; align-items: flex-start; }
  .cat-card { display: flex; flex-direction: column; width: 100%; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: zoom-in; }
  .cat-card .frame img { object-fit: contain; transition: transform .6s ease; } /* front view shown whole; the frame takes its edge colour */
  .cat-card:hover .frame img { transform: scale(1.03); }
  .cat-card:focus-visible { outline: 1px solid var(--text); outline-offset: 6px; }
  /* Finish swatches under the picture: small dots, the chosen one ringed; wood and fabric split by a thin line */
  .cat-swatches { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 12px; }
  .cat-swatches > span { display: flex; gap: 8px; }
  .cat-swatches > span + span { padding-left: 12px; border-left: 1px solid var(--line); }
  .sw { position: relative; width: 16px; height: 16px; padding: 0; border: 0; border-radius: 50%; background: var(--sw); box-shadow: inset 0 0 0 .5px var(--line); cursor: pointer; outline: .5px solid transparent; outline-offset: 1.5px; transition: outline-color .2s; }
  .sw:hover { outline-color: var(--text-soft); }
  /* Bigger preview on hover or keyboard focus, so the wood grain can be seen */
  .sw::after { content: ''; position: absolute; left: 50%; bottom: calc(100% + 10px); width: 76px; height: 76px; border-radius: 50%; background: var(--sw); box-shadow: 0 0 0 3px var(--bg), 0 6px 18px rgba(0, 0, 0, .18); opacity: 0; transform: translateX(-50%) scale(.6); transform-origin: 50% 100%; transition: opacity .2s, transform .2s; pointer-events: none; z-index: 3; }
  .sw:hover::after, .sw:focus-visible::after { opacity: 1; transform: translateX(-50%) scale(1); }
  .sw[aria-pressed='true'] { outline-color: var(--text); }
  .sw:focus-visible { outline: 1px solid var(--text); }
  .cat-name { margin-top: 14px; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 24px; line-height: 1.15; }
  .cat-size { margin-top: 4px; font-size: 13px; letter-spacing: .08em; color: var(--text-soft); }
  .cat-more { margin-top: 64px; padding-inline: var(--cat-edge); text-align: center; }
  .cat-views { margin-top: 6px; font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--text-soft); }
  @media (max-width: 1000px) { .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .cat-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .cat-card .frame img, .sw, .sw::after { transition: none; } }

</style>
