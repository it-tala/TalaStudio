---
interface Props { title?: string; text?: string; href?: string; label?: string }
const {
  title = 'Let’s build your next range.',
  text = 'Tell us what you sell and where. We will come back with the pieces, finishes and a container plan that fit.',
  href = '/contact',
  label = 'Start a conversation',
} = Astro.props;
import { pageOn } from '../data/sections';
---
{pageOn(href) && (
<section class="section alt">
  <div class="wrap" style="text-align:center">
    <h2>{title}</h2>
    <p class="lede" style="margin-inline:auto">{text}</p>
    <a class="btn" href={href} style="margin-top:2rem">{label}</a>
  </div>
</section>
)}
