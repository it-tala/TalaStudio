---
// Full-screen photo viewer with zoom. Render it once on a page, then open it from the page script:
//   import { openLightbox } from '../../lib/lightbox';   openLightbox([{ src, alt, caption }], startIndex)
---
<dialog class="lightbox" aria-label="Photo viewer">
  <button type="button" class="lb-btn lb-close" aria-label="Close">×</button>
  <div class="lb-stage"><img alt="" draggable="false" /></div>
  <div class="lb-foot">
    <p class="lb-cap"></p>
    <div class="lb-swatches" role="group" aria-label="Finish"></div>
    <p class="lb-hint">
      <span class="fine">Click or scroll to zoom. Drag to move around.</span>
      <span class="coarse">Tap or pinch to zoom. Swipe for the next photo.</span>
    </p>
  </div>
  <div class="lb-zoom" role="group" aria-label="Zoom">
    <button type="button" class="lb-btn lb-out" aria-label="Zoom out">−</button>
    <button type="button" class="lb-btn lb-in" aria-label="Zoom in">+</button>
  </div>
  <button type="button" class="lb-btn lb-prev" aria-label="Previous photo">‹</button>
  <button type="button" class="lb-btn lb-next" aria-label="Next photo">›</button>
</dialog>

<style is:global>
  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; overflow: hidden; background: rgba(20, 17, 14, .96); color: #f3ece2; }
  .lightbox::backdrop { background: transparent; }
  /* Fade in (and out where the browser can animate leaving the top layer) */
  .lightbox { opacity: 0; transition: opacity .2s ease-out, display .2s allow-discrete, overlay .2s allow-discrete; }
  .lightbox[open] { opacity: 1; }
  @starting-style { .lightbox[open] { opacity: 0; } }

  .lb-stage { position: absolute; inset: 0 0 4.5rem 0; overflow: hidden; display: flex; touch-action: none; user-select: none; -webkit-user-select: none; }
  .lb-stage img { margin: auto; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; flex: none; transform-origin: center; cursor: zoom-in; -webkit-user-drag: none; }
  .lightbox.lb-ease .lb-stage img { transition: transform .25s ease-out; }
  .lightbox.zoomed .lb-stage img { cursor: grab; }
  .lightbox.dragging .lb-stage img { cursor: grabbing; }

  /* Footer under the photo: caption, finish dots (when the page passes finishes), hint */
  .lb-foot { position: absolute; left: 0; right: 0; bottom: 0; height: 4.5rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .55rem; padding-inline: 1rem; pointer-events: none; }
  .lightbox.has-finishes .lb-stage { bottom: 7rem; }
  .lightbox.has-finishes .lb-foot { height: 7rem; }
  .lb-cap { margin: 0; text-align: center; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; }
  .lb-hint { margin: 0; text-align: center; font-size: .7rem; opacity: .55; }
  .lb-swatches { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; pointer-events: auto; }
  .lb-swatches:empty { display: none; }
  .lb-swatch { width: 1.5rem; height: 1.5rem; padding: 0; border: 1px solid rgba(243, 236, 226, .35); border-radius: 50%; background: var(--swatch); cursor: pointer; transition: box-shadow .15s; }
  .lb-swatch:hover { box-shadow: 0 0 0 3px #1a1714, 0 0 0 4px rgba(243, 236, 226, .45); }
  .lb-swatch[aria-pressed='true'] { box-shadow: 0 0 0 3px #1a1714, 0 0 0 4px #f3ece2; }
  .lb-swatch:focus-visible { outline: 2px solid #f3ece2; outline-offset: 5px; }
  .lb-hint .coarse { display: none; }
  @media (pointer: coarse) { .lb-hint .fine { display: none; } .lb-hint .coarse { display: inline; } }

  /* Dark buttons with a light ring, so they show over the dark surround and over light render backgrounds alike */
  .lb-btn { position: absolute; z-index: 2; width: 2.8rem; height: 2.8rem; border: 0; border-radius: 50%; background: rgba(20, 17, 14, .6); box-shadow: 0 0 0 1px rgba(243, 236, 226, .3); color: inherit; font-size: 1.8rem; line-height: 1; cursor: pointer; }
  .lb-btn:hover { background: rgba(20, 17, 14, .85); }
  .lb-btn:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-zoom { position: absolute; z-index: 2; top: 1rem; right: 4.4rem; display: flex; gap: .5rem; }
  .lb-zoom .lb-btn { position: static; font-size: 1.5rem; }
  .lb-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 1rem; top: 50%; transform: translateY(-50%); }
  .lightbox.zoomed .lb-prev, .lightbox.zoomed .lb-next { opacity: .5; }
  .lightbox.single .lb-prev, .lightbox.single .lb-next { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .lightbox, .lightbox.lb-ease .lb-stage img { transition: none; }
  }
</style>
