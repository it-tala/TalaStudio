---
// A photo (or two overlapping) with its caption, inside a Story section
import Shot from '../Shot.astro';
import type { StoryFigure } from '../../data/pages';

interface Props { figure: StoryFigure; class?: string }
const { figure, class: cls } = Astro.props;
---
<figure class:list={[cls, { stack: figure.shots.length === 2, trio: figure.shots.length === 3 }]}>
  {figure.shots.map((s) => <Shot {...s} />)}
  {figure.caption && <figcaption>{figure.caption}</figcaption>}
</figure>

<style>
  figure { margin: 0; }
  figcaption { margin-top: .6rem; font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; color: var(--text-soft); }
  .wide { margin-top: clamp(.8rem, 2vw, 1.2rem); }

  /* Two photos overlapping, the small one over the big one's lower left corner */
  .stack { position: relative; padding: 0 0 18% 0; }
  .stack :global(.back) { width: 82%; margin-left: auto; }
  .stack :global(.front) { position: absolute; left: 0; bottom: 2.2rem; width: 52%; box-shadow: 0 18px 40px rgba(0, 0, 0, .18); }
  .stack figcaption { text-align: right; }
  .small { max-width: 22rem; margin-top: 2rem; }

  /* Three photos stepping down from right to left and back, as the user's mock-up: no shadows, and the middle one lies
     over the edges of the other two (Quality control) */
  .trio { display: flex; flex-direction: column; }
  .trio :global(.shot) { position: relative; }
  .trio :global(.q1) { width: 65%; margin-left: auto; }
  .trio :global(.q2) { width: 52%; margin-top: -3%; z-index: 1; }
  .trio :global(.q3) { width: 84%; margin-left: auto; margin-top: -5%; }
</style>
