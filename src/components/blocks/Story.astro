---
// One numbered section: label, heading and copy beside a photo (How We Work 01–06 and the closing goal).
// With a gallery, the heading sits left of the copy and the photos run in a row underneath.
// Without a figure or gallery the copy takes the whole width.
import Figure from './StoryFigure.astro';
import Copy from './StoryCopy.astro';
import { pageOn } from '../../data/sections';
import type { StoryBlock } from '../../data/pages';

interface Props { block: StoryBlock }
const { id, tone, num, title, copy = [], figure, figureFirst, aside, gallery, top, link } = Astro.props.block;
---
<section class:list={['section', tone]} id={id}>
  {gallery ? (
    <div class="wrap">
      <div class="split">
        <div>
          <p class="num">{num}</p>
          <h2>{title}</h2>
        </div>
        <Copy copy={copy} />
      </div>
      {gallery.row && <div class="row three">{gallery.row.map((f) => <Figure figure={f} />)}</div>}
      {gallery.wide && <Figure figure={gallery.wide} class="wide" />}
      {gallery.mosaic && <Figure figure={gallery.mosaic} class="mosaic" />}
    </div>
  ) : (
    <div class:list={['wrap', { pair: figure, top }]}>
      {figure && figureFirst && <Figure figure={figure} />}
      <div>
        <p class="num">{num}</p>
        <h2>{title}</h2>
        {copy.length > 0 && <Copy copy={copy} />}
        {aside && <Figure figure={aside} class="small" />}
        {link && pageOn(link.href) && <a class="btn" href={link.href}>{link.label}</a>}
      </div>
      {figure && !figureFirst && <Figure figure={figure} />}
    </div>
  )}
</section>

<style>
  section[id] { scroll-margin-top: 4.5rem; }
  .num { font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; }
  h2 { max-width: 18ch; }
  h2 + :global(.copy) { margin-top: 1.5rem; }

  .split, .pair { display: grid; gap: clamp(2rem, 5vw, 4.5rem); }
  .pair { align-items: center; }
  .row { display: grid; gap: clamp(.8rem, 2vw, 1.2rem); margin-top: clamp(2rem, 5vw, 3.5rem); }

  .goal .num { color: var(--accent); }
  .goal h2 { font-size: clamp(1.8rem, 3.4vw, 2.8rem); max-width: 18ch; }
  .goal .btn { margin-top: 2rem; }

  @media (min-width: 700px) {
    .row.three { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 900px) {
    .split { grid-template-columns: 1fr 1.2fr; }
    .pair { grid-template-columns: 1fr 1fr; }
    .pair.top { align-items: start; }
  }
</style>
