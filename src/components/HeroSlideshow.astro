---
// Hero background: one cover per collection behind the hero copy, switched with a short crossfade.
// A click on the right half of a cover moves to the next one, on the left half to the previous one, like the picture
// viewer (without script the cover is a plain link to its collection page). The pictures only change with clicks, arrows
// and dots, never by themselves. Each change sends a hero-slide event (detail.href = the collection page) that the home
// collections section follows, and a coll-room event from that section (a room picked there) switches the picture here.
// The page's own hero copy sits on the first cover only; the other covers show just their collection's name, bottom right.
// That name is a link down to the collections section, which already shows that collection's room.
//
// Each cover is a <picture> that fills the screen under the header (object-fit: cover, user 13 Nov 2026; it replaces
// "never cropped" of 12 Nov): on a phone or any upright screen the 9:16 phone picture (cut from the 16:9 master by the
// content pipeline, or the team's own from LP 1 MOBILE LINK), else the 16:9 master; AVIF first, WebP for the rest, and
// the browser picks the width this screen needs (sizes 100vw). Where the cut falls on screen: hero-focus.mjs.
// The first cover is a normal high-priority picture, preloaded from the page head (index.astro), so it is fetched once,
// at the right size. The others carry their sources as data-srcset and are only fetched in the background once the page
// is up (lib/preload); a cover is switched in only once its picture is decoded. Until then a cover shows its own edge
// colours (--band).
import { srcsetOf, portraitOf } from '../lib/content';
interface Props {
  slides: { src: string; label: string; name: string; href: string; room: string; text: string; edge?: string | null; band?: string | null;
    focus?: { x?: number; y?: number; portrait?: number } }[];
}
const { slides } = Astro.props;
const SIZES = '100vw';
// The first cover's sources are live; the others wait in data-srcset until the script loads them
const set = (i: number, v: string | undefined) => (!v ? {} : i === 0 ? { srcset: v } : { 'data-srcset': v });
---
{slides.length === 0 && <div class="media"></div>}
{slides.map((s, i) => {
  const avif = srcsetOf(s.src, 'avif');
  const webp = srcsetOf(s.src, 'webp');
  const p = portraitOf(s.src);
  const f = s.focus ?? {};
  // Where the 16:9 picture sits when the screen cuts it; on an upright screen without a phone picture, its focus point
  const style = [s.band && `--band:${s.band}`, f.x != null && `--x:${f.x}%`, f.y != null && `--y:${f.y}%`,
    !p && (f.portrait ?? f.x) != null && `--px:${f.portrait ?? f.x}%`].filter(Boolean).join(';') || undefined;
  return (
    <a
      class:list={['media', 'slide', { on: i === 0 }]}
      href={s.href}
      aria-label={`${s.name}: ${s.label}`}
      aria-hidden={i === 0 ? undefined : 'true'}
      tabindex={i === 0 ? undefined : -1}
      style={style}
      data-room={s.room}
      data-name={s.name.replace(/ collection$/, '')}
      data-edge={s.edge ?? undefined}
    >
      <picture>
        {p?.avif && <source media="(orientation: portrait)" type="image/avif" sizes={SIZES} {...set(i, p.avif)} />}
        {p?.webp && <source media="(orientation: portrait)" type="image/webp" sizes={SIZES} {...set(i, p.webp)} />}
        {avif && <source type="image/avif" sizes={SIZES} {...set(i, avif)} />}
        <img
          {...(i === 0 ? { src: s.src } : { 'data-src': s.src })}
          {...set(i, webp)}
          sizes={webp && SIZES}
          alt=""
          draggable="false"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding={i === 0 ? undefined : 'async'}
        />
      </picture>
    </a>
  );
})}
{slides.length > 1 && (
  <button type="button" class="hero-arrow prev" aria-label="Previous picture">‹</button>
  <button type="button" class="hero-arrow next" aria-label="Next picture">›</button>
  <div class="hero-names">
    {slides.map((s, i) => <a href="#collections" class:list={{ on: i === 0 }} aria-hidden={i === 0 ? undefined : 'true'} tabindex={i === 0 ? undefined : -1}>{s.name}</a>)}
  </div>
  <div class="hero-dots" role="group" aria-label="Hero pictures">
    {slides.map((s, i) => <button type="button" aria-label={`Show ${s.label}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
  </div>
)}

<script>
  import { preload, prefer } from '../lib/preload';
  // The arrows and dots switch pictures; nothing advances by itself.
  document.querySelectorAll<HTMLElement>('.hero-full').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('.hero-dots button')];
    const names = [...hero.querySelectorAll<HTMLElement>('.hero-names a')];
    // A cover's sources go live (the <source>s first, so the <img> picks among them), and it is only switched in once
    // its picture is decoded, so it never fades in half-drawn
    const ready = new Map<HTMLElement, Promise<void>>();
    const load = (s: HTMLElement) => {
      if (!ready.has(s)) {
        const img = s.querySelector('img');
        if (!img) ready.set(s, Promise.resolve());
        else {
          s.querySelectorAll<HTMLElement>('[data-srcset]').forEach((e) => { e.setAttribute('srcset', e.dataset.srcset!); delete e.dataset.srcset; });
          if (img.dataset.src) { img.src = img.dataset.src; delete img.dataset.src; }
          img.loading = 'eager';
          ready.set(s, img.decode().catch(() => {}));
        }
      }
      return ready.get(s)!;
    };
    // In the background with the page's other pictures (lib/preload): first the next four covers (and the one before,
    // for the left arrow), the rest later. Using the hero moves its covers ahead again.
    slides.forEach((s, i) => { if (i > 0) preload(`hero:${i}`, 'hero', i <= 4 || i === slides.length - 1 ? 0 : 3, () => load(s)); });
    if (slides.length < 2) return;
    hero.addEventListener('pointerenter', () => prefer('hero'));
    hero.addEventListener('focusin', () => prefer('hero'));

    let cur = 0;
    let want = 0;
    // quiet: the collections section asked for this picture, so it is not told back
    const show = async (i: number, quiet = false) => {
      const next = (i + slides.length) % slides.length;
      want = next;
      await load(slides[next]);
      if (want !== next || next === cur) return; // a later click won, or nothing to change
      cur = next;
      slides.forEach((s, j) => {
        if (j === cur) { s.classList.add('on'); s.removeAttribute('aria-hidden'); s.removeAttribute('tabindex'); }
        else { s.classList.remove('on'); s.setAttribute('aria-hidden', 'true'); s.setAttribute('tabindex', '-1'); }
      });
      dots.forEach((d, j) => (j === cur ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      names.forEach((n, j) => {
        n.classList.toggle('on', j === cur);
        if (j === cur) { n.removeAttribute('aria-hidden'); n.removeAttribute('tabindex'); }
        else { n.setAttribute('aria-hidden', 'true'); n.setAttribute('tabindex', '-1'); }
      });
      // The page copy sits on the first picture only; the others carry just the name
      hero.classList.toggle('copy-off', cur !== 0);
      // The collections section further down follows: it shows the room of the collection on this picture
      if (!quiet) hero.dispatchEvent(new CustomEvent('hero-slide', { bubbles: true, detail: { href: slides[cur].getAttribute('href') } }));
    };
    // The other way round: a room picked in the collections section shows its picture here. A room with no picture of
    // its own (Doheny living) shows its collection's picture.
    document.addEventListener('coll-room', (e) => {
      const { slug, name } = (e as CustomEvent<{ slug?: string; name?: string }>).detail;
      let j = slides.findIndex((s) => slug && s.getAttribute('href') === `#coll-${slug}`);
      if (j < 0) j = slides.findIndex((s) => name && s.dataset.name === name);
      if (j >= 0) show(j, true);
    });
    dots.forEach((d, j) => d.addEventListener('click', () => show(j)));
    hero.querySelector('.hero-arrow.prev')?.addEventListener('click', () => show(cur - 1));
    hero.querySelector('.hero-arrow.next')?.addEventListener('click', () => show(cur + 1));
    // Invisible buttons on the cover, as in the picture viewer: the left half goes back, the right half forward
    const back = (s: HTMLElement, x: number) => { const r = s.getBoundingClientRect(); return x < r.left + r.width / 2; };
    slides.forEach((s) => {
      s.addEventListener('click', (e) => {
        e.preventDefault();
        show(cur + (back(s, e.clientX) ? -1 : 1));
      });
      // The pointer shows which way a click goes
      s.addEventListener('mousemove', (e) => {
        const b = back(s, e.clientX);
        s.classList.toggle('to-prev', b);
        s.classList.toggle('to-next', !b);
      });
    });
  });
</script>
