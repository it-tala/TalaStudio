---
// Hero background: one cover per collection behind the hero copy, switched with a short crossfade.
// The first cover loads with the page; the rest load once it is up. A click on the right half of a cover moves to the
// next one, on the left half to the previous one, like the picture viewer (without script the cover is a plain link
// to its collection page). The pictures only change with clicks, arrows and dots, never by themselves. Each change sends a
// hero-slide event (detail.href = the collection page) that the home collections section follows, and a coll-room event
// from that section (a room picked there) switches the picture here.
// The page's own hero copy sits on the first cover only; the other covers show just their collection's name, bottom right.
// That name is a link down to the collections section, which already shows that collection's room.
interface Props { slides: { src: string; label: string; name: string; href: string; room: string; text: string; pos?: string; edge?: string | null }[] }
const { slides } = Astro.props;
---
{slides.length === 0 && <div class="media"></div>}
{slides.map((s, i) => (
  <a
    class:list={['media', 'slide', { on: i === 0 }]}
    href={s.href}
    aria-label={`${s.name}: ${s.label}`}
    aria-hidden={i === 0 ? undefined : 'true'}
    tabindex={i === 0 ? undefined : -1}
    style={[i === 0 && `--img:url(${s.src})`, s.pos && `--pos:${s.pos}`].filter(Boolean).join(';') || undefined}
    data-bg={i === 0 ? undefined : s.src}
    data-src={s.src}
    data-room={s.room}
    data-name={s.name.replace(/ collection$/, '')}
    data-edge={s.edge ?? undefined}
  ></a>
))}
{slides.length > 1 && (
  <button type="button" class="hero-arrow prev" aria-label="Previous picture">‹</button>
  <button type="button" class="hero-arrow next" aria-label="Next picture">›</button>
  <div class="hero-names">
    {slides.map((s, i) => <a href="#collections" class:list={{ on: i === 0 }} aria-hidden={i === 0 ? undefined : 'true'} tabindex={i === 0 ? undefined : -1}>{s.name}</a>)}
  </div>
  <div class="hero-dots" role="group" aria-label="Hero pictures">
    {slides.map((s, i) => <button type="button" aria-label={`Show ${s.label}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
  </div>
)}

<script>
  // The arrows and dots switch pictures; nothing advances by itself.
  document.querySelectorAll<HTMLElement>('.hero-full').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('.hero-dots button')];
    const names = [...hero.querySelectorAll<HTMLElement>('.hero-names a')];
    if (slides.length < 2) return;
    // A cover is only switched in once its picture is decoded, so it never fades in half-drawn
    const ready = new Map<HTMLElement, Promise<void>>();
    const load = (s: HTMLElement) => {
      if (!ready.has(s)) {
        const src = s.dataset.bg;
        if (!src) ready.set(s, Promise.resolve());
        else {
          const img = new Image();
          img.src = src;
          ready.set(s, img.decode().catch(() => {}).then(() => { s.style.setProperty('--img', `url(${src})`); delete s.dataset.bg; }));
        }
      }
      return ready.get(s)!;
    };
    const loadAll = () => slides.forEach(load);
    if (document.readyState === 'complete') loadAll(); else addEventListener('load', loadAll, { once: true });

    let cur = 0;
    let want = 0;
    // quiet: the collections section asked for this picture, so it is not told back
    const show = async (i: number, quiet = false) => {
      const next = (i + slides.length) % slides.length;
      want = next;
      await load(slides[next]);
      if (want !== next || next === cur) return; // a later click won, or nothing to change
      cur = next;
      slides.forEach((s, j) => {
        if (j === cur) { s.classList.add('on'); s.removeAttribute('aria-hidden'); s.removeAttribute('tabindex'); }
        else { s.classList.remove('on'); s.setAttribute('aria-hidden', 'true'); s.setAttribute('tabindex', '-1'); }
      });
      dots.forEach((d, j) => (j === cur ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      names.forEach((n, j) => {
        n.classList.toggle('on', j === cur);
        if (j === cur) { n.removeAttribute('aria-hidden'); n.removeAttribute('tabindex'); }
        else { n.setAttribute('aria-hidden', 'true'); n.setAttribute('tabindex', '-1'); }
      });
      // The page copy sits on the first picture only; the others carry just the name
      hero.classList.toggle('copy-off', cur !== 0);
      // The collections section further down follows: it shows the room of the collection on this picture
      if (!quiet) hero.dispatchEvent(new CustomEvent('hero-slide', { bubbles: true, detail: { href: slides[cur].getAttribute('href') } }));
    };
    // The other way round: a room picked in the collections section shows its picture here. A room with no picture of
    // its own (Doheny living) shows its collection's picture.
    document.addEventListener('coll-room', (e) => {
      const { slug, name } = (e as CustomEvent<{ slug?: string; name?: string }>).detail;
      let j = slides.findIndex((s) => slug && s.getAttribute('href') === `#coll-${slug}`);
      if (j < 0) j = slides.findIndex((s) => name && s.dataset.name === name);
      if (j >= 0) show(j, true);
    });
    dots.forEach((d, j) => d.addEventListener('click', () => show(j)));
    hero.querySelector('.hero-arrow.prev')?.addEventListener('click', () => show(cur - 1));
    hero.querySelector('.hero-arrow.next')?.addEventListener('click', () => show(cur + 1));
    // Invisible buttons on the cover, as in the picture viewer: the left half goes back, the right half forward
    const back = (s: HTMLElement, x: number) => { const r = s.getBoundingClientRect(); return x < r.left + r.width / 2; };
    slides.forEach((s) => {
      s.addEventListener('click', (e) => {
        e.preventDefault();
        show(cur + (back(s, e.clientX) ? -1 : 1));
      });
      // The pointer shows which way a click goes
      s.addEventListener('mousemove', (e) => {
        const b = back(s, e.clientX);
        s.classList.toggle('to-prev', b);
        s.classList.toggle('to-next', !b);
      });
    });
  });
</script>
