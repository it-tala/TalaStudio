---
const nav = [
  ['Collections', '/collections'],
  ['How we work', '/how-we-work'],
  ['The Studio', '/the-studio'],
  ['How a container works', '/how-a-container-works'],
  ['Partner with us', '/partner-with-us'],
  ['Contact', '/contact'],
];
---
<style>
  header { border-bottom: 1px solid var(--line); background: var(--bg); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4.5rem; }
  .logo { font: 500 1.6rem 'Cormorant Garamond', Georgia, serif; text-decoration: none; letter-spacing: .04em; }
  nav { display: none; gap: 1.6rem; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; }
  nav a { text-decoration: none; color: var(--text-soft); }
  nav a:hover { color: var(--text); }
  details { position: relative; }
  summary { cursor: pointer; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; list-style: none; }
  .menu { position: absolute; right: 0; top: 2.2rem; background: var(--bg); border: 1px solid var(--line); padding: 1rem 1.4rem; display: grid; gap: .8rem; min-width: 14rem; }
  .menu a { text-decoration: none; }
  @media (min-width: 1000px) { nav { display: flex; } details { display: none; } }
</style>
<header>
  <div class="wrap bar">
    <a class="logo" href="/">TalaStudio</a>
    <nav aria-label="Main">{nav.map(([t, h]) => <a href={h}>{t}</a>)}</nav>
    <a class="btn" href="/request-catalog" style="padding:.6rem 1.2rem;font-size:.75rem">Request catalog</a>
    <details>
      <summary>Menu</summary>
      <div class="menu">{nav.map(([t, h]) => <a href={h}>{t}</a>)}</div>
    </details>
  </div>
</header>
