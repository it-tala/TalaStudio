---
import { pageOn } from '../data/sections';
import { catalog } from '../data/catalog';
const nav = [
  ['How we work', '/how-we-work'],
  ['Who we are', '/who-we-are'],
  ['The Studio', '/the-studio'],
  ['How a container works', '/how-a-container-works'],
  ['Partner with us', '/partner-with-us'],
  ['Contact', '/contact'],
].filter(([, href]) => pageOn(href));
---
<style>
  header { border-bottom: 1px solid var(--line); background: var(--bg); position: sticky; top: 0; z-index: 10; }
  /* Full width with a side gutter that grows with the screen, so logo and menu sit out towards the edges */
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4.5rem; padding-inline: clamp(20px, 4vw, 72px); }
  /* The TS mark is a mask, so it takes the logo brown here and the text colour on the dark palette */
  .logo { display: flex; align-items: center; gap: .7rem; color: #584538; font: 500 1.35rem 'Cormorant Garamond', Georgia, serif; text-transform: uppercase; letter-spacing: .16em; text-decoration: none; }
  .logo i { width: 2.6rem; aspect-ratio: 412 / 398; background: currentColor; -webkit-mask: url(/logo-mark.png) center / contain no-repeat; mask: url(/logo-mark.png) center / contain no-repeat; }
  :global([data-theme='charcoal']) .logo { color: var(--text); }
  nav { display: none; gap: clamp(1.6rem, 2.4vw, 3rem); font-size: .85rem; letter-spacing: .1em; text-transform: uppercase; }
  nav a { text-decoration: none; color: var(--text-soft); }
  nav a:hover { color: var(--text); }

  /* Mobile: logo + three-line menu button only */
  details { position: static; }
  summary { list-style: none; cursor: pointer; width: 2.75rem; height: 2.75rem; display: grid; place-content: center; gap: 5px; }
  summary::-webkit-details-marker { display: none; }
  summary span { display: block; width: 24px; height: 2px; background: var(--text); transition: transform .2s ease, opacity .2s ease; }
  details[open] summary span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  details[open] summary span:nth-child(2) { opacity: 0; }
  details[open] summary span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .menu { position: absolute; left: 0; right: 0; top: 100%; background: var(--bg); border-bottom: 1px solid var(--line); padding: 1.25rem 1.25rem 1.75rem; display: grid; gap: 1.1rem; }
  .menu a { text-decoration: none; font-size: 1rem; letter-spacing: .08em; text-transform: uppercase; }

  /* Download catalog button: top right beside the links on wide screens, inside the menu on phones.
     It sits outside <nav> so the link colours above do not apply to it. */
  .right { display: flex; align-items: center; gap: clamp(1.6rem, 2.4vw, 3rem); }
  .cat { display: none; padding: .7rem 1.4rem; font-size: .8rem; letter-spacing: .1em; white-space: nowrap; }
  .menu .btn { justify-self: start; margin-top: .4rem; padding: .8rem 1.5rem; font-size: .85rem; letter-spacing: .1em; }

  @media (min-width: 1000px) {
    nav { display: flex; }
    details { display: none; }
    .cat { display: inline-block; }
  }
</style>
<header>
  <div class="bar">
    <a class="logo" href="/" aria-label="TalaStudio home"><i aria-hidden="true"></i>TalaStudio</a>
    <div class="right">
      <nav aria-label="Main">
        {nav.map(([t, h]) => <a href={h}>{t}</a>)}
      </nav>
      <a class="btn cat" href={catalog.href} download={catalog.file} data-catalog>{catalog.label}</a>
    </div>
    <details>
      <summary aria-label="Menu"><span></span><span></span><span></span></summary>
      <div class="menu">
        {nav.map(([t, h]) => <a href={h}>{t}</a>)}
        <a class="btn" href={catalog.href} download={catalog.file} data-catalog>{catalog.label}</a>
      </div>
    </details>
  </div>
</header>
