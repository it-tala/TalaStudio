---
import { pageOn } from '../data/sections';
---
<style>
  /* Same text style as the navbar links: Inter, 0.8rem, uppercase, 0.1em spacing, weight 400 */
  footer { background: var(--bg-dark); color: var(--on-dark); padding-block: 4rem 1rem; font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: .85rem; font-weight: 400; letter-spacing: .1em; text-transform: uppercase; line-height: 1.7; }
  /* Wide footer: 25px from each screen edge */
  footer .wrap { width: calc(100% - 50px); max-width: none; }
  /* Four columns spread across the width, every one open and flush left */
  .cols { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 2.5rem 2rem; text-align: left; }
  .cols > div { flex: 0 1 auto; }
  .cols > div:first-child { max-width: 20rem; }
  /* Tablet and phone: two columns, two rows */
  /* Tablet and phone: the TalaStudio blurb gets its own row, the link lists sit below it in two columns, with more air
     between rows and quieter text so the block does not feel packed */
  @media (max-width: 1000px) {
    .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem 2rem; }
    .cols > div:first-child { grid-column: 1 / -1; max-width: 30rem; }
    .cols p { text-transform: none; letter-spacing: .01em; line-height: 1.6; opacity: .75; }
    ul { gap: .85rem; }
    a { font-size: .8rem; letter-spacing: .08em; }
    footer .small { margin-top: 3rem; padding-top: 1.25rem; font-size: .7rem; }
  }
  /* Narrow phones: one column, so long links such as the email address fit the screen */
  @media (max-width: 520px) {
    .cols { grid-template-columns: minmax(0, 1fr); }
  }
  h4 { font: 500 .8rem Inter, sans-serif; letter-spacing: .16em; text-transform: uppercase; opacity: .6; margin-bottom: 1rem; }
  ul { list-style: none; padding: 0; display: grid; gap: .5rem; }
  a { text-decoration: none; opacity: .85; overflow-wrap: anywhere; }
  a:hover { opacity: 1; }
  .small { margin: 1.5rem 0 0; padding-top: .75rem; border-top: 1px solid rgba(236, 229, 217, .15); opacity: .6; text-align: left; font-size: .75rem; letter-spacing: .08em; }
</style>
<footer>
  <div class="wrap">
    <div class="cols">
      <div><h4>TalaStudio</h4><p>Furniture designed, engineered and costed in one place. Jepara, Indonesia.</p></div>
      <div><h4>Explore</h4><ul>
        {pageOn('/the-studio') && <li><a href="/the-studio">The Studio, Jepara</a></li>}
        <li><a href="/how-we-work">How we work</a></li>
        <li><a href="/who-we-are">Who we are</a></li>
        <li><a href="/insights">Insights</a></li></ul></div>
      <div><h4>Buyers</h4><ul>
        {pageOn('/how-a-container-works') && <li><a href="/how-a-container-works">How a container works</a></li>}
        <li><a href="/sourcing-from-indonesia">Sourcing from Indonesia</a></li>
        {pageOn('/partner-with-us') && <li><a href="/partner-with-us">Partner with us</a></li>}
        <li><a href="/buyer-dashboard">Buyer dashboard demo</a></li></ul></div>
      <div><h4>Contact</h4><ul>
        <li><a href="mailto:hello@talastudio.net">hello@talastudio.net</a></li>
        {pageOn('/request-catalog') && <li><a href="/request-catalog">Request catalog</a></li>}
        <li><a href="/contact">Book a showroom visit</a></li>
        <li><a href="/privacy-and-terms">Privacy and terms</a></li></ul></div>
    </div>
    <p class="small">© {new Date().getFullYear()} TalaStudio. All designs are protected.</p>
  </div>
</footer>
