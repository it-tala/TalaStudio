<style>
  /* Sized after the shopharbour.com footer (layout only): wide side margins, tracked 16px headings,
     14px uppercase links on a 33px rhythm, the brand note and catalog button in the last column. */
  footer { background: var(--bg-dark); color: var(--on-dark); padding: 5.5rem clamp(1.25rem, 3.6vw, 4.5rem) 2.75rem; font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; }
  .cols { display: flex; justify-content: space-between; align-items: flex-start; gap: 3rem 2rem; }
  .cols > div { flex: 0 1 auto; }
  h4 { font: 500 1rem/1.2 Inter, sans-serif; letter-spacing: .2em; text-transform: uppercase; margin-bottom: 1.5rem; }
  ul { list-style: none; padding: 0; display: grid; gap: .8rem; }
  li { font-size: .875rem; line-height: 1.45; }
  /* overflow-wrap: the email address is wider than a phone column */
  a { letter-spacing: .02em; text-transform: uppercase; text-decoration: none; opacity: .8; overflow-wrap: anywhere; }
  a:hover { opacity: 1; }
  .about { max-width: 16rem; }
  .about p { font-size: .875rem; line-height: 1.65; opacity: .8; }
  .about .btn { display: inline-block; margin-top: 1.6rem; padding: .95rem 1.8rem; font-size: .8rem; letter-spacing: .2em; opacity: 1; }
  .base { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: .75rem 2rem; margin-top: 8.5rem; }
  .mark { font-size: .875rem; letter-spacing: .2em; text-transform: uppercase; }
  .note { font-size: .75rem; letter-spacing: .04em; opacity: .55; }
  /* Tablet and phone: two columns, the brand note across the full width */
  @media (max-width: 1000px) {
    footer { padding-top: 4rem; }
    .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem 2rem; }
    .about { grid-column: 1 / -1; max-width: 26rem; }
    .base { margin-top: 4.5rem; }
  }
</style>
