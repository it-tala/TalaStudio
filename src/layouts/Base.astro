---
import '../styles/global.css';
import '../styles/layout.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string; image?: string; theme?: string }
const { title, description, image = '/og-default.jpg', theme } = Astro.props;
const full = title.startsWith('TalaStudio') ? title : `${title} | TalaStudio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image, Astro.site);
const cf = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
// Pre-launch: keep Google out while the site shows sample data, or when PUBLIC_NOINDEX=true.
const noindex = import.meta.env.PUBLIC_USE_SAMPLE_DATA === 'true' || import.meta.env.PUBLIC_NOINDEX === 'true';
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TalaStudio" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
    {cf && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cf })}></script>}
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
