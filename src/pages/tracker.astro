  .tk-user { display: flex; gap: 1rem; align-items: center; font-size: .9rem; }
  .tk-user .tk-link { color: var(--on-dark); }
  .tk-note { background: #f3dcc7; padding: .7rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
  .tk-card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 1.1rem 1.2rem; margin-bottom: 1rem; }
  .tk-card h3, .tk-login h2 { font: 600 .95rem/1.3 Inter, sans-serif; margin-bottom: .8rem; }
  .tk-card h3 small { font-weight: 400; color: var(--text-soft); margin-left: .4rem; }
  .tk-login { max-width: 380px; margin: 3rem auto; }
  .tk-login form { display: grid; gap: .8rem; }
  .tk-login .tk-msg { margin-top: .8rem; }
  .tk-login input[name='code'] { font-size: 1.4rem; letter-spacing: .3em; text-align: center; }
  .tk-login h2 { font-size: 1.3rem; }
  .tk label { display: grid; gap: .25rem; font-size: .82rem; color: var(--text-soft); }
  .tk input[type='email'], .tk input[type='password'], .tk input[type='text'], .tk input[type='search'], .tk select, .tk textarea {
    font: inherit; font-size: .9rem; color: var(--text); background: #fbf8f3; border: 1px solid var(--soft); border-radius: 6px; padding: .5rem .65rem; }
  .tk textarea { width: 100%; font: .85rem/1.5 ui-monospace, Consolas, monospace; margin: .7rem 0; resize: vertical; }
  .tk-btn { font: 500 .88rem Inter, sans-serif; background: var(--bg-dark); color: var(--on-dark); border: 1px solid var(--bg-dark); border-radius: 6px; padding: .55rem 1rem; cursor: pointer; }
  .tk-btn.ghost { background: transparent; color: var(--text); border-color: var(--soft); }
  .tk-btn:disabled { opacity: .45; cursor: default; }
  .tk-link { font: inherit; font-size: .88rem; background: none; border: 0; padding: 0; color: var(--accent); text-decoration: underline; cursor: pointer; }
  .tk-link.danger { color: var(--bad); }
  .tk-msg { font-size: .85rem; color: var(--text-soft); }
  .tk-help { font-size: .88rem; color: var(--text-soft); margin-bottom: .8rem; max-width: 70ch; }
  .tk-file { position: relative; overflow: hidden; display: inline-block; color: var(--text); font-size: .88rem; }
  .tk-file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .tk-tabs { display: flex; gap: .3rem; margin-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .tk-tabs button { font: 500 .95rem Inter, sans-serif; background: none; border: 0; padding: .6rem 1rem; color: var(--text-soft); border-bottom: 2px solid transparent; cursor: pointer; }
  .tk-tabs button[aria-selected='true'] { color: var(--text); border-color: var(--accent); }
  .tk-filters, .tk-actions { display: flex; gap: 1rem; align-items: end; flex-wrap: wrap; margin-bottom: 1rem; }
  .tk-actions { margin-bottom: 0; align-items: center; }
  .tk-card .tk-filters { margin-bottom: 0; }
  .tk-check { display: flex !important; flex-direction: row; align-items: center; gap: .4rem !important; padding-bottom: .5rem; }
  .tk-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: .8rem; }
  .tk-head h3 { margin: 0; }
  .tk-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .8rem; margin-bottom: 1rem; }
  .tk-kpi { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: .9rem 1rem; display: grid; gap: .15rem; }
  .tk-kpi small { font-size: .78rem; color: var(--text-soft); text-transform: uppercase; letter-spacing: .06em; }
  .tk-kpi b { font: 500 2rem/1.1 'Cormorant Garamond', serif; }
  .tk-kpi span { font-size: .78rem; color: var(--text-soft); }
  .tk-chart { display: flex; align-items: end; gap: 3px; height: 160px; }
  .tk-col { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: end; align-items: center; min-width: 4px; }
  .tk-col span { width: 100%; background: var(--accent); border-radius: 3px 3px 0 0; min-height: 1px; opacity: .85; }
  .tk-col small { font-size: .65rem; color: var(--text-soft); height: 1rem; }
  .tk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0 1rem; }
  .tk-bars { list-style: none; padding: 0; display: grid; gap: .35rem; }
  .tk-bars li { position: relative; display: flex; justify-content: space-between; gap: .8rem; padding: .3rem .5rem; font-size: .86rem; }
  .tk-fill { position: absolute; inset: 0 auto 0 0; background: rgba(138, 90, 59, .14); border-radius: 4px; }
  .tk-bl, .tk-bars b { position: relative; }
  .tk-bl small { color: var(--text-soft); }
  .tk-bars b { font-weight: 600; white-space: nowrap; }
  .tk-empty { color: var(--text-soft); font-size: .88rem; padding: .4rem 0; }
  .tk-scroll { overflow-x: auto; }
  .tk-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  .tk-table th { text-align: left; font-weight: 600; color: var(--text-soft); font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; padding: .5rem .6rem; border-bottom: 1px solid var(--soft); white-space: nowrap; }
  .tk-table td { padding: .55rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .tk-table td small { display: block; color: var(--text-soft); font-size: .78rem; }
  .tk-table tr[data-v] { cursor: pointer; }
  .tk-table tr[data-v]:hover, .tk-table tr[data-v]:focus { background: rgba(138, 90, 59, .07); outline: none; }
  .tk-table tr.tk-sub td { color: var(--text-soft); border-bottom-style: dashed; }
  .tk-mono { font-family: ui-monospace, Consolas, monospace; font-size: .8rem; }
  .tk-linkcell { word-break: break-all; min-width: 220px; }
  .tk-anon { color: var(--text-soft); font-style: italic; }
  .tk-detail { margin: auto; width: min(900px, 100% - 2rem); max-height: 85vh; border: 1px solid var(--line); border-radius: 10px; padding: 1.2rem; background: var(--card); color: var(--text); }
  .tk-detail::backdrop { background: rgba(20, 18, 16, .45); }
  @media (max-width: 640px) {
    .tk-kpis { grid-template-columns: 1fr 1fr; gap: .5rem; }
    .tk-kpi { padding: .7rem .8rem; }
    .tk-kpi b { font-size: 1.6rem; }
    .tk-top h1 span { display: block; margin: .3rem 0 0; }
  }
</style>
