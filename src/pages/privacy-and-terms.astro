---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// DRAFT FOR LEGAL REVIEW. Written to the usual standard for a B2B furniture manufacturer's site.
// Have a lawyer check it, and update the legal entity and governing law once the Hong Kong company is set up.
const updated = '13 October 2026';

const privacy = [
  ['who-we-are', 'Who we are', [
    'TalaStudio ("we", "us") designs furniture collections in Jepara, Indonesia, and sells them by the container to trade buyers: retailers, buying groups and distributors.',
    'We are the controller of the personal data described here. Contact us at hello@talastudio.net for any privacy question.',
  ]],
  ['what-we-collect', 'What we collect', [
    'Catalog request form: your full name, company, country, email address, phone number (optional), buyer type and message.',
    'Emails and calls with us: the content of what you send, and notes we keep about the conversation.',
    'Website usage: page views, referrer, country, device and browser type, collected by privacy-friendly analytics without advertising cookies.',
    'We do not run a shop and we do not collect payment card details on this site.',
  ]],
  ['why-we-use-it', 'Why we use it', [
    'To send you the catalog and reply to your request.',
    'To follow up about your interest and manage our relationship with your company.',
    'To keep the website secure, prevent spam and understand which pages are useful.',
    'To meet legal obligations.',
    'Where the law requires a legal basis, we rely on our legitimate interest in responding to business enquiries and running a trade website, on steps taken at your request before an agreement, and on legal obligation. We do not rely on consent for the form, and you can ask us to stop contacting you at any time.',
  ]],
  ['sharing', 'Who we share it with', [
    'Our sales team has access. We do not sell or rent your personal data.',
    'Service providers process data for us only to run the site and our communications: database and hosting (Supabase, Cloudflare), email (Google Workspace and our email delivery provider), spam protection (Cloudflare Turnstile) and analytics (Cloudflare Web Analytics, Google Search Console).',
    'We may disclose data if required by law, or to protect our rights, or in a sale or restructuring of the business.',
  ]],
  ['transfers', 'International transfers', [
    'We operate from Indonesia and sell mainly to buyers in the United States. Your data may be processed in countries other than your own, including by providers in the United States and the European Union. Where required, we use appropriate safeguards such as standard contractual clauses.',
  ]],
  ['retention', 'How long we keep it', [
    'We keep catalog requests and related records for as long as we have a business relationship or a reasonable prospect of one, then delete or anonymise them. We keep records for longer where the law requires it, for example order and tax records.',
  ]],
  ['security', 'Security', [
    'Data is stored in a managed database with row-level access controls, and access is limited to staff with a business need and protected by two-step login. No system is perfectly secure, but we take reasonable steps to protect your data.',
  ]],
  ['rights', 'Your rights', [
    'Depending on where you live, you may have the right to access, correct, delete or export your personal data, to object to or restrict our use of it, and to withdraw consent where we rely on it. This includes rights under the GDPR and UK GDPR for people in Europe and the UK, and under US state laws such as the California Consumer Privacy Act.',
    'Email hello@talastudio.net and we will respond within the time the law requires. You can also complain to your local data protection authority. We do not sell personal data and we do not use it for cross-context advertising.',
  ]],
  ['cookies', 'Cookies and analytics', [
    'We use Cloudflare Web Analytics, which does not use cookies or track you across sites. Cloudflare Turnstile may use limited browser storage to tell people from bots. We do not use advertising or marketing cookies.',
  ]],
  ['not-for-children', 'Not for children', [
    'This site is for business buyers and is not directed at children. We do not knowingly collect data from anyone under 16.',
  ]],
  ['privacy-changes', 'Changes to this policy', [
    'We may update this policy. The date at the top shows when it last changed. Material changes will be flagged on this page.',
  ]],
];

const terms = [
  ['trade-site', 'Trade website', [
    'This website is for business buyers. By using it you agree to these terms. If you do not agree, please do not use the site.',
  ]],
  ['no-offer', 'No offer to sell, no prices', [
    'Content on this site is for information only and is not an offer to sell. We do not publish prices. Prices, minimum order quantities, lead times and availability are provided in quotes and our catalog, and apply only when confirmed in writing.',
  ]],
  ['orders', 'Orders and sales terms', [
    'Orders are governed by a separate written agreement or accepted quote between you and us. It will set out the price, Incoterms (typically FOB Indonesia), payment terms, production and delivery schedule, inspection, warranty and dispute resolution. Where it conflicts with these terms, the agreement prevails.',
  ]],
  ['accuracy', 'Product information', [
    'We take care to show our products accurately. Sizes, weights, carton data, colours and finishes shown online are approximate. Colours on screens vary, and natural materials such as wood differ in grain and tone. Confirm specifications and request samples before ordering.',
  ]],
  ['ip', 'Intellectual property', [
    'All designs, drawings, renders, photographs, text, logos and other content on this site are owned by us or our licensors and are protected by copyright, design rights and other laws. You may view the site and share a link to it, but you may not copy, reproduce, modify, publish or use it to make products without our written permission.',
    'Product images are watermarked. Do not remove or hide a watermark.',
  ]],
  ['confidentiality', 'Confidential materials', [
    'The catalog, drawings and any unreleased designs we share are confidential. Do not share them with third parties, and do not use them to have copies made, without our written consent. We may require a signed confidentiality agreement before sharing full collections.',
  ]],
  ['dashboard', 'Buyer dashboard demo', [
    'The buyer dashboard page uses sample data to show how order tracking works. It does not show real orders, customers or shipments.',
  ]],
  ['acceptable-use', 'Acceptable use', [
    'Do not misuse the site: do not attempt to gain unauthorised access, disrupt it, scrape it at scale, submit false or spam enquiries, or use it for anything unlawful.',
  ]],
  ['liability', 'Disclaimer and limits of liability', [
    'The site is provided "as is". To the fullest extent permitted by law, we do not warrant that it will be error-free or always available, and we are not liable for indirect or consequential loss, or loss of profit, arising from your use of it. Nothing limits liability that cannot be limited by law. Liability under a sales agreement is governed by that agreement.',
  ]],
  ['links', 'Third-party links', [
    'The site may link to other websites. We do not control them and are not responsible for their content or privacy practices.',
  ]],
  ['law', 'Governing law', [
    'These terms are governed by the law stated in your sales agreement with us. Where there is none, they are governed by the law of the jurisdiction in which TalaStudio is established at the time of the dispute, and its courts have jurisdiction.',
  ]],
  ['terms-changes', 'Changes and contact', [
    'We may update these terms at any time by posting the new version here. Continued use means you accept the changes. Questions: hello@talastudio.net.',
  ]],
];

const toc = [['Privacy policy', privacy], ['Terms of use', terms]] as const;
---
<Base
  title="Privacy and terms"
  description="TalaStudio's privacy policy and terms of use: what we collect through the catalog form, how we protect it, your rights, and the terms for using this trade website."
>
  <PageHero eyebrow="Legal" title="Privacy and terms." lede={`Last updated ${updated}.`} />

  <section class="section">
    <div class="wrap legal">
      <aside>
        <nav aria-label="On this page">
          {toc.map(([label, items]) => (
            <>
              <p class="eyebrow">{label}</p>
              <ul>{items.map(([id, title]) => <li><a href={`#${id}`}>{title}</a></li>)}</ul>
            </>
          ))}
        </nav>
      </aside>

      <div class="body">
        <h2 id="privacy">Privacy policy</h2>
        <p class="intro">This policy explains how TalaStudio handles personal data collected through this website, in particular the catalog request form.</p>
        {privacy.map(([id, title, paras], i) => (
          <section id={id}>
            <h3>{i + 1}. {title}</h3>
            {(paras as string[]).map((p) => <p>{p}</p>)}
          </section>
        ))}

        <h2 id="terms" style="margin-top:4rem">Terms of use</h2>
        <p class="intro">These terms apply to your use of talastudio.net.</p>
        {terms.map(([id, title, paras], i) => (
          <section id={id}>
            <h3>{i + 1}. {title}</h3>
            {(paras as string[]).map((p) => <p>{p}</p>)}
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .legal { display: grid; gap: 3rem; }
  aside nav { position: sticky; top: 6rem; font-size: .9rem; }
  aside ul { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: .5rem; }
  aside a { text-decoration: none; color: var(--text-soft); }
  aside a:hover { color: var(--text); }
  .body { max-width: 46rem; }
  .body h2 { font-size: clamp(2rem, 4vw, 2.8rem); }
  .body h3 { font-size: 1.5rem; margin-top: 2.2rem; }
  .body p { margin-top: .8rem; color: var(--text-soft); }
  .body .intro { font-size: 1.1rem; }
  .body section { scroll-margin-top: 6rem; }
  @media (min-width: 900px) { .legal { grid-template-columns: 15rem 1fr; gap: 5rem; } }
  @media (max-width: 899px) { aside { display: none; } }
</style>
