---
import Base from '../layouts/Base.astro';

// Font pairings to choose from, each shown on the same pieces of the site. All are free Google Fonts.
// display = headlines and logo; text = body, navigation, labels.
const options = [
  {
    key: 'a', name: 'A. Cormorant Garamond + Inter', note: 'Current. Fine, high-contrast serif with a neutral sans. Elegant; the serif turns thin below 20px.',
    display: "'Cormorant Garamond', Georgia, serif", weight: 500, track: '-.01em', text: "'Inter', system-ui, sans-serif",
  },
  {
    key: 'b', name: 'B. Cormorant Garamond + Jost', note: 'Same headlines, with a geometric sans for menus and labels. Tracked capitals closest to the reference site.',
    display: "'Cormorant Garamond', Georgia, serif", weight: 500, track: '-.01em', text: "'Jost', system-ui, sans-serif",
  },
  {
    key: 'c', name: 'C. Jost only', note: 'One geometric family, light headlines. The most minimal and modern; less warmth than a serif.',
    display: "'Jost', system-ui, sans-serif", weight: 300, track: '-.02em', text: "'Jost', system-ui, sans-serif",
  },
  {
    key: 'd', name: 'D. Marcellus + Jost', note: 'Flared, carved-letter headlines with a clean sans. Quiet luxury, reads well in capitals.',
    display: "'Marcellus', Georgia, serif", weight: 400, track: '0', text: "'Jost', system-ui, sans-serif",
  },
  {
    key: 'e', name: 'E. EB Garamond + Manrope', note: 'A sturdier book serif with a soft modern sans. Warm and very readable at every size.',
    display: "'EB Garamond', Georgia, serif", weight: 400, track: '-.01em', text: "'Manrope', system-ui, sans-serif",
  },
];
const dresser = '/collections/bedroom/beechwood/items/6-drawer-dresser/natural-jati/front.webp';
---
<Base title="Font options" description="Internal preview of font pairings for Evin to choose from.">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Jost:wght@300;400;500&family=Manrope:wght@400;500&family=Marcellus&display=swap" />
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Internal. Not in sitemap.</p>
      <h1>Pick a font pairing.</h1>
      <p class="lede">Each option shows the same parts of the site: menu, headline, text, a collection card and the footer.</p>
      <div class="list">
        {options.map((o) => (
          <article class="opt" style={`--font-display:${o.display};--display-weight:${o.weight};--display-track:${o.track};--font-text:${o.text}`}>
            <header class="opt-head">
              <h2 class="opt-name">{o.name}</h2>
              <p class="opt-note">{o.note}</p>
            </header>

            <div class="nav">
              <span class="logo">TalaStudio</span>
              <span class="links"><span>Collections</span><span>How we work</span><span>The Studio</span><span>Contact</span><span class="cta">Request catalog</span></span>
            </div>

            <div class="body">
              <div class="hero">
                <p class="eyebrow-s">Jepara, Indonesia</p>
                <p class="headline">The forward look, at a value price.</p>
                <p class="para">TalaStudio designs furniture with the look the most forward retailers are selling. We price it where your customers actually buy.</p>
                <span class="btn-s">Request catalog</span>
              </div>
              <div class="card">
                <span class="frame"><img src={dresser} alt="" loading="lazy" /></span>
                <p class="card-name">6-Drawer Dresser</p>
                <p class="card-meta">Natural Jati</p>
                <span class="card-link">View details</span>
              </div>
            </div>

            <div class="foot">
              <div><p class="foot-h">Explore</p><p class="foot-a">Collections</p><p class="foot-a">The Studio, Jepara</p></div>
              <div><p class="foot-h">Buyers</p><p class="foot-a">How a container works</p><p class="foot-a">Partner with us</p></div>
              <div class="foot-mark">© TalaStudio</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .list { display: grid; gap: 2.5rem; margin-top: 3rem; }
  .opt { border: 1px solid var(--line); background: var(--bg); font-family: var(--font-text); }
  .opt-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: .5rem 2rem; padding: 1.4rem 1.6rem; border-bottom: 1px solid var(--line); background: var(--bg-alt); }
  .opt-name { font: 500 1rem/1.3 Inter, system-ui, sans-serif; letter-spacing: .04em; }
  .opt-note { max-width: 40rem; font: 400 .9rem/1.5 Inter, system-ui, sans-serif; color: var(--text-soft); }

  .nav { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .8rem 2rem; padding: 1.1rem 1.6rem; border-bottom: 1px solid var(--line); }
  .logo { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 1.6rem; letter-spacing: .04em; }
  .links { display: flex; flex-wrap: wrap; gap: .6rem 1.6rem; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-soft); }
  .links .cta { color: var(--accent); border-bottom: 1px solid currentColor; }

  .body { display: grid; gap: 2.5rem; padding: 2.5rem 1.6rem; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: center; }
  .eyebrow-s { font-size: .75rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-soft); }
  .headline { margin-top: .8rem; font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.08; }
  .para { margin-top: 1.1rem; max-width: 34rem; font-size: 1.05rem; line-height: 1.65; color: var(--text-soft); }
  .btn-s { display: inline-block; margin-top: 1.6rem; padding: .9rem 1.8rem; background: var(--accent); color: #fff; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; }
  .card .frame { background: #fff; }
  .card-name { margin-top: .9rem; font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: 1.45rem; line-height: 1.2; }
  .card-meta { font-size: .9rem; color: var(--text-soft); }
  .card-link { display: inline-block; margin-top: .6rem; font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  .foot { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1.5rem 3rem; padding: 2rem 1.6rem; background: var(--bg-dark); color: var(--on-dark); }
  .foot-h { margin-bottom: .9rem; font-size: 1rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; }
  .foot-a { font-size: .875rem; letter-spacing: .02em; text-transform: uppercase; opacity: .8; line-height: 2.1; }
  .foot-mark { font-size: .875rem; letter-spacing: .2em; text-transform: uppercase; }

  @media (max-width: 760px) { .body { grid-template-columns: 1fr; } }
</style>
