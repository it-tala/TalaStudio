---
import Base from '../layouts/Base.astro';
import Ph from '../components/Ph.astro';
import { getCollection } from 'astro:content';
import { getCollections, imageUrl } from '../lib/supabase';
import { story } from '../data/story';
import { edgeBackground } from '../lib/edge';
import sharp from 'sharp';
import { join } from 'node:path';
import { showSection } from '../data/sections';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import ItemCatalog from '../components/ItemCatalog.astro';
import { groupItems, itemRooms } from '../lib/items';
import { heroPos } from '../data/hero-pos';

const all = await getCollections();
// Landing page collections, in this order. Each card has its item catalog right underneath. Add a slug to show another.
// Slots ready for 'calabasas' and 'palisades' (same layout); hidden until their pieces are in.
const featured = ['doheny'];
// The pieces each landing page catalog shows (in catalog order); the rest are on the collection page. Leave a slug out to show all.
const homeItems: Record<string, string[]> = {
  doheny: ['Queen Bed', '6 Drawer Dresser', '7 Foot Sofa', 'Coffee Table'],
};
// Hero: one slide per room that has a real room shot (hero.jpg), rooms of the same collection side by side
// (Doheny bedroom, then Doheny living); a room that only borrows a product photo as its cover is skipped.
// A click goes to that room's collection page.
const withRoomShot = all.filter((c) => /\/hero\.(jpe?g|png|webp)$/.test(c.hero_image_path ?? ''));
const nameOrder = [...new Set(withRoomShot.map((c) => c.name))];
const heroSlides = [...withRoomShot].sort((x, y) => nameOrder.indexOf(x.name) - nameOrder.indexOf(y.name))
  .map((c) => ({
    src: imageUrl(c.hero_image_path)!,
    label: `${c.name} collection, ${c.room} render`,
    name: `${c.name} collection`,
    href: `/collections/${c.slug}`,
    pos: heroPos[c.slug]?.pos,
    room: c.room === 'other' ? 'Collection' : `${c.room} collection`,
    text: c.description ?? `A ${c.room === 'other' ? '' : c.room + ' '}collection, drawn, engineered and costed in our Jepara studio.`,
  }));
// A landing page card covers the whole collection: its pieces from every room (Doheny bedroom and living together)
const collections = featured.map((s) => all.find((c) => c.slug === s)).filter((c): c is (typeof all)[number] => c !== undefined)
  .map((c) => ({ ...c, gallery: all.filter((x) => x.name === c.name).flatMap((x) => x.gallery ?? []) }));
// Card picture: the cover (room shot) of each piece in turn, same order as the catalog underneath. The frame is 16:9 like
// the room shots; a taller shot (the mirror's) is shown whole, on its own edge colour, instead of being cut.
const coverList = Object.fromEntries(await Promise.all(collections.map(async (c) => [c.slug, await Promise.all(groupItems(c).map(async (it) => {
  const src = it.pics[0].src;
  const meta = await sharp(join(process.cwd(), 'public', src)).metadata().catch(() => null);
  const tall = !!meta?.width && !!meta.height && meta.width / meta.height < 1.5;
  return { name: it.name, src, bg: tall ? await edgeBackground(src, 16 / 9) : null };
}))])));
const covers = (c: (typeof all)[number]) => coverList[c.slug] ?? [];
// The first three pieces in catalog order (bed first), leaving out hidden photos
const pieceNames = (c: (typeof all)[number]) => groupItems(c).map((it) => it.name).slice(0, 3).join(', ');
const bgs: Record<string, string | null> = Object.fromEntries(await Promise.all(collections.map(async (c) => [c.slug, c.hero_image_path ? await edgeBackground(c.hero_image_path) : null])));
const posts = (await getCollection('insights', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const rooms = [
  ['Bedroom', 'Rest, in calm shapes', 'bedroom'],
  ['Living', 'Seating made to be sat in', 'living'],
  ['Dining', 'Tables made to gather round', 'dining'],
];
const materials = [
  ['Solid wood', 'Worked in Jepara, where the craft is local.'],
  ['Finishes', 'Developed and tested in the studio.'],
  ['Joinery', 'Engineered while we design, not after.'],
];
---
<Base
  title="TalaStudio | Studio designed, shipped at scale"
  description="TalaStudio designs bedroom, living and dining furniture in Jepara, Indonesia and sells it by the container to retailers, buying groups and distributors."
>
  <!-- 1. Hero -->
  <section class="hero-full">
    <HeroSlideshow slides={heroSlides} />
    <div class="inner">
      <p class="eyebrow">Jepara, Indonesia</p>
      <h1 class="hero-stack"><span>{story.headline[0]}</span><span>{story.headline[1]}</span></h1>
      <p class="text">{story.promise}</p>
      <div class="btns">
        <a class="btn ghost" href="/collections">View collections</a>
      </div>
    </div>
  </section>

  <!-- 3. Shop by space (overlay tiles) -->
  {showSection.home.byRoom && (
  <section class="section">
    <div class="tiles-head">
      <div><h2>By space</h2></div>
      <a class="link" style="margin:0" href="/collections">All collections</a>
    </div>
    <ul class="tiles">
      {rooms.map(([n, d]) => (
        <li>
          <a class="tile" href="/collections">
            <Ph label={`${n} render`} watermark />
            <div class="cap"><small>{d}</small><h3>{n}</h3><em>Explore</em></div>
          </a>
        </li>
      ))}
    </ul>
  </section>
  )}

  <!-- 4. Studio story -->
  {showSection.home.studioStory && (
  <section class="section alt">
    <div class="split">
      <div class="media"><Ph label="Jepara studio" /></div>
      <div>
        <p class="eyebrow">The studio</p>
        <h2 class="statement">{story.title}</h2>
        <p class="text">{story.studioBlurb}</p>
        <a class="link" href="/the-studio">See the studio</a>
        <a class="link" style="margin-left:2rem" href="/who-we-are">Our story</a>
      </div>
    </div>
  </section>
  )}

  <!-- 5. Collections -->
  <section class="section">
    <div class="coll-intro">
      <p class="eyebrow">Collections</p>
      <h2>A first look at the range.</h2>
      <p>Living and bedroom are ready to view, and dining follows. Each collection is drawn, engineered and costed in our Jepara studio. The full range is in the catalog.</p>
    </div>
    {collections.length > 0 ? (
      <div class="feat-grid">
        {collections.map((c) => (
          <>
          <div class="feat-card" id={`coll-${c.slug}`}>
            {covers(c).length > 1 ? (
              <div class="frame feat-slides" role="group" aria-roledescription="carousel" aria-label={`${c.name} pieces`}>
                <div class="fs-track" tabindex="0" aria-label="Scroll sideways for each piece">
                  {covers(c).map((p, i) => (
                    <figure class:list={['fs-slide', { whole: p.bg }]} style={p.bg ? `background:${p.bg}` : undefined}>
                      <img src={p.src} alt={`${c.name} ${p.name}`} loading={i === 0 ? 'eager' : 'lazy'} />
                      <figcaption>{p.name}<span aria-hidden="true">|</span>{c.name}</figcaption>
                    </figure>
                  ))}
                </div>
                <button type="button" class="fs-arrow prev" aria-label="Previous piece">‹</button>
                <button type="button" class="fs-arrow next" aria-label="Next piece">›</button>
              </div>
            ) : imageUrl(c.hero_image_path)
              ? <span class="frame" style={bgs[c.slug] ? `background:${bgs[c.slug]}` : undefined}><img src={imageUrl(c.hero_image_path)!} alt={`${c.name} render`} loading="lazy" /></span>
              : <Ph label={`${c.name} render`} watermark />}
            <div class="feat-body">
              <small>Collection</small>
              <h3>{c.name}</h3>
              {c.description && <p>{c.description}</p>}
              <span class="feat-meta">
                <span><i>Room</i>{itemRooms(c).join(', ') || (c.room === 'other' ? 'Collection' : c.room)}</span>
                {pieceNames(c) && <span><i>Includes</i>{pieceNames(c)}</span>}
              </span>
              <a class="feat-more" href={`/collections/${c.slug}`}>Explore the collection</a>
            </div>
          </div>
          <ItemCatalog collection={c} only={homeItems[c.slug]} />
          </>
        ))}
      </div>
    ) : (
      <p class="coll-intro">First collections arrive soon.</p>
    )}
  </section>

  <!-- 6. Materials -->
  {showSection.home.materials && (
  <section class="section alt">
    <div class="tiles-head">
      <div><p class="eyebrow">Materials and finishes</p><h2>Built to be used, made to last.</h2></div>
    </div>
    <ul class="tiles">
      {materials.map(([n, d]) => (
        <li>
          <div class="tile">
            <Ph label={`${n} detail`} />
            <div class="cap"><h3>{n}</h3><small style="margin-top:6px;text-transform:none;letter-spacing:0;font-size:14px">{d}</small></div>
          </div>
        </li>
      ))}
    </ul>
  </section>
  )}

  <!-- 7. Journal -->
  {posts.length > 0 && (
    <section class="section">
      <div class="tiles-head"><div><h2>Insights</h2></div><a class="link" style="margin:0" href="/insights">All articles</a></div>
      <div class="journal">
        {posts.map((p) => (
          <a href={`/insights/${p.id}`}>
            <time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h3>{p.data.title}</h3><p>{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 8. For buyers (dark split) -->
  {showSection.home.forBuyers && (
  <section class="section dark">
    <div class="split">
      <div>
        <p class="eyebrow">For buyers</p>
        <h2>Mix collections in one container.</h2>
        <p class="text">For retailers, buying groups and distributors. Regional exclusivity is available and agreed case by case.</p>
        <div class="btns">
          <a class="btn" href="/how-a-container-works">How a container works</a>
          <a class="btn ghost" href="/partner-with-us">Partner with us</a>
        </div>
      </div>
      <div class="media"><Ph label="Container load" /></div>
    </div>
  </section>
  )}

  <!-- 9. Visit -->
  {showSection.home.visit && (
  <section class="section">
    <div class="split right">
      <div class="media"><Ph label="Showroom" /></div>
      <div>
        <p class="eyebrow">Visit us</p>
        <h2>See, sit and feel the range.</h2>
        <p class="text">Our showroom is the Jepara studio. Visits are by appointment.</p>
        <div class="btns"><a class="btn" href="/contact">Book a visit</a></div>
      </div>
    </div>
  </section>
  )}
</Base>

<script>
  // Collection card picture: one slide per piece. Swipe or scroll sideways, or use the arrows; moves on every 5 seconds
  // while the mouse is elsewhere. With reduced motion it only moves when asked.
  document.querySelectorAll<HTMLElement>('.feat-slides').forEach((box) => {
    const track = box.querySelector<HTMLElement>('.fs-track')!;
    const prev = box.querySelector<HTMLButtonElement>('.prev')!;
    const next = box.querySelector<HTMLButtonElement>('.next')!;
    const n = track.children.length;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const at = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
    const go = (i: number) => track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior: still.matches ? 'auto' : 'smooth' });
    let timer = 0;
    let hover = false;
    const start = () => {
      clearInterval(timer);
      if (!still.matches && !hover && !document.hidden) timer = window.setInterval(() => go(at() + 1), 5000);
    };
    prev.addEventListener('click', () => { go(at() - 1); start(); });
    next.addEventListener('click', () => { go(at() + 1); start(); });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(at() - 1); start(); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(at() + 1); start(); }
    });
    box.addEventListener('mouseenter', () => { hover = true; start(); });
    box.addEventListener('mouseleave', () => { hover = false; start(); });
    track.addEventListener('touchstart', start, { passive: true }); // a swipe restarts the count
    document.addEventListener('visibilitychange', start);
    still.addEventListener('change', start);
    start();
  });
</script>
