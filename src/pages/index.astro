---
import Base from '../layouts/Base.astro';
import Ph from '../components/Ph.astro';
import { getCollection } from 'astro:content';
import { getCollections, imageUrl } from '../lib/supabase';
import { story } from '../data/story';
import { edgeBackground, photoRatio } from '../lib/edge';
import { content, pictureId, srcsetOf, portraitOf, avifHashes, HERO_SIZES, HERO_PORTRAIT_SIZES } from '../lib/content';
import { focusOf } from '../data/hero-focus.mjs';
import Picture from '../components/Picture.astro';
import { showSection } from '../data/sections';
import CtaBand from '../components/CtaBand.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import ItemCatalog from '../components/ItemCatalog.astro';
import { groupItems, itemRooms } from '../lib/items';
import { versioned } from '../lib/version';

const all = await getCollections();
// The pieces each landing page catalog shows (in catalog order); the rest are on the collection page. Leave a slug out to show all.
const homeItems: Record<string, string[]> = {};
const roomOrder = ['bedroom', 'living', 'dining', 'other'];
const roomLabel = (r: string) => (r === 'other' ? 'Collection' : `${r[0].toUpperCase()}${r.slice(1)} collection`);
// Hero: one slide per room that has a real room shot (LP 1 LINK), rooms of the same collection side by side
// (Doheny bedroom, then Doheny living); a room that only borrows a product photo as its cover is skipped.
// Each shows whole on a landscape screen; where the phone picture is cut comes from src/data/hero-focus.mjs (focus).
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const withRoomShot = all.filter((c) => c.hero_is_room);
const nameOrder = [...new Set(withRoomShot.map((c) => c.name))];
const heroSlides = await Promise.all([...withRoomShot].sort((x, y) => nameOrder.indexOf(x.name) - nameOrder.indexOf(y.name))
  .map(async (c) => ({
    src: versioned(imageUrl(c.hero_image_path)!),
    label: `${c.name} collection, ${c.room} render`,
    name: `${c.name} collection`,
    href: `#coll-${c.slug}`,
    room: c.room === 'other' ? 'Collection' : `${c.room} collection`,
    text: c.description ?? `A ${c.room === 'other' ? '' : c.room + ' '}collection, drawn, engineered and costed in our Jepara studio.`,
    // Colour round the picture when the viewer shows it whole in its square
    edge: await edgeBackground(imageUrl(c.hero_image_path)!, 1),
    // The picture's own edge colours, shown in the cover until the picture is drawn
    band: await edgeBackground(imageUrl(c.hero_image_path)!, 16 / 9),
    focus: focusOf(`${slugify(c.name)}/${c.room}`),
  })));
// The first cover, fetched from the head before the page is read: the 9:16 phone picture on an upright screen, else the
// 16:9 master, as AVIF (a browser without AVIF skips these and takes the <img>'s WebP). The same srcset and sizes as the
// <picture> in HeroSlideshow, so the browser takes the preloaded file and fetches nothing twice.
const first = heroSlides[0]?.src;
const firstAvif = first ? srcsetOf(first, 'avif') : undefined;
const firstPortrait = first ? portraitOf(first)?.avif : undefined;
// One panel per collection room, grouped as on the collections page: each collection in list order (Doheny first),
// inside it bedroom → living → dining. Only one panel shows at a time; the arrows under its items switch rooms.
// Rooms without any item are left out.
const collections = [...new Set(all.map((c) => c.name))]
  .flatMap((name) => all.filter((c) => c.name === name).sort((x, y) => roomOrder.indexOf(x.room) - roomOrder.indexOf(y.room)))
  .filter((c) => groupItems(c).length > 0);
// One panel per collection: its rooms in order (Doheny bedroom, Doheny living). The room shot slider runs through every
// room of the collection; the copy, the room label and the items below follow the room of the slide on show.
const groups = [...new Set(collections.map((c) => c.name))].map((name) => collections.filter((c) => c.name === name));
const roomName = (c: (typeof all)[number]) => roomLabel(c.room).replace(/ collection$/, '');
// Card picture: the cover (room shot) of each piece in turn, same order as the catalog underneath. The frame is 16:9 like
// the room shots; a taller shot (the mirror's) is shown whole, on its own edge colour, instead of being cut.
// Each piece's picture is its ROOM HERO 1 shot from the sheet (RM 1 LINK; a piece without one is skipped).
// No picture twice in one room: pieces often share a room shot (one album link), so a shot already on the card is
// skipped, and a "room shot" that is the same picture as a product photo is a product shot: it is left off too.
const pickCovers = (c: (typeof all)[number]) => {
  const items = groupItems(c);
  const used = new Set<string>(items.flatMap((it) => it.pics.filter((p) => !p.cover && !p.spec).map((p) => pictureId(p.src))));
  return items.flatMap((it) => {
    const pick = it.pics.find((p) => p.cover && !used.has(pictureId(p.src)));
    if (!pick) return [];
    used.add(pictureId(pick.src));
    return [{ name: it.name, src: pick.src }];
  });
};
const coverList = Object.fromEntries(await Promise.all(collections.map(async (c) => [c.slug, await Promise.all(pickCovers(c).map(async (it) => {
  const src = it.src;
  const ratio = await photoRatio(src);
  const tall = ratio > 0 && ratio < 1.5;
  return { name: it.name, src, bg: tall ? await edgeBackground(src, 16 / 9) : null };
}))])));
// A room with no piece in a room shot keeps a place in the slider with its own room shot (LP 1 LINK)
const covers = (c: (typeof all)[number]) =>
  coverList[c.slug]?.length ? coverList[c.slug] : c.hero_image_path ? [{ name: '', src: imageUrl(c.hero_image_path)!, bg: null }] : [];
const slidesOf = (rooms: (typeof all)[number][]) => rooms.flatMap((c) => covers(c).map((p) => ({ ...p, c })));
// The first three pieces in catalog order (bed first), leaving out hidden photos
const pieceNames = (c: (typeof all)[number]) => groupItems(c).map((it) => it.name).slice(0, 3).join(', ');
const posts = (await getCollection('insights', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const rooms = [
  ['Bedroom', 'Rest, in calm shapes', 'bedroom'],
  ['Living', 'Seating made to be sat in', 'living'],
  ['Dining', 'Tables made to gather round', 'dining'],
];
const materials = [
  ['Solid wood', 'Worked in Jepara, where the craft is local.'],
  ['Finishes', 'Developed and tested in the studio.'],
  ['Joinery', 'Engineered while we design, not after.'],
];
---
<Base
  title="TalaStudio | Studio designed, shipped at scale"
  description="TalaStudio designs bedroom, living and dining furniture in Jepara, Indonesia and sells it by the container to retailers, buying groups and distributors."
>
  <Fragment slot="head">
    {firstPortrait && <link rel="preload" as="image" type="image/avif" imagesrcset={firstPortrait} imagesizes={HERO_PORTRAIT_SIZES} media="(orientation: portrait)" fetchpriority="high" />}
    {firstAvif && <link rel="preload" as="image" type="image/avif" imagesrcset={firstAvif} imagesizes={HERO_SIZES} media={firstPortrait ? '(orientation: landscape)' : undefined} fetchpriority="high" />}
  </Fragment>
  <!-- 1. Hero -->
  <section class="hero-full">
    <HeroSlideshow slides={heroSlides} />
    <div class="inner">
      <p class="eyebrow">Jepara, Indonesia</p>
      <h1 class="hero-stack"><span>{story.headline[0]}</span><span>{story.headline[1]}</span></h1>
      <p class="text">{story.promise}</p>
    </div>
  </section>
  <!-- The pictures with an AVIF copy, for the pictures built by script (viewer, spec page, loading ahead): lib/picture.ts -->
  <script type="application/json" id="avif-set" set:html={JSON.stringify(avifHashes(Object.keys(content.assets).map((h) => `/img/${h}/0.webp`)))} />

  <!-- 3. Shop by space (overlay tiles) -->
  {showSection.home.byRoom && (
  <section class="section">
    <div class="tiles-head">
      <div><h2>By space</h2></div>
      <a class="link" style="margin:0" href="/collections">All collections</a>
    </div>
    <ul class="tiles">
      {rooms.map(([n, d]) => (
        <li>
          <a class="tile" href="/collections">
            <Ph label={`${n} render`} watermark />
            <div class="cap"><small>{d}</small><h3>{n}</h3><em>Explore</em></div>
          </a>
        </li>
      ))}
    </ul>
  </section>
  )}

  <!-- 4. Studio story -->
  {showSection.home.studioStory && (
  <section class="section alt">
    <div class="split">
      <div class="media"><Ph label="Jepara studio" /></div>
      <div>
        <p class="eyebrow">The studio</p>
        <h2 class="statement">{story.title}</h2>
        <p class="text">{story.studioBlurb}</p>
        <a class="link" href="/the-studio">See the studio</a>
        <a class="link" style="margin-left:2rem" href="/who-we-are">Our story</a>
      </div>
    </div>
  </section>
  )}

  <!-- 5. Collections (the menu's Collections link lands here) -->
  <section class="section" id="collections">
    <div class="coll-intro">
      <p class="eyebrow">Collections</p>
      <h2>A first look at the range.</h2>
      <p>Living and bedroom are ready to view, and dining follows. Each collection is drawn, engineered and costed in our Jepara studio. The full range is in the catalog.</p>
    </div>
    {groups.length > 0 ? (
      <div class="feat-grid room-panels">
        {groups.map((rooms, n) => (
          <div class="room-panel" data-name={rooms[0].name} data-room={rooms[0].slug} hidden={n > 0 ? true : undefined}>
          <div class="feat-card" id={`coll-${rooms[0].slug}`}>
            {slidesOf(rooms).length > 0 ? (
              <div class="frame feat-slides" role="group" aria-roledescription="carousel" aria-label={`${rooms[0].name} pieces, room by room`}>
                <div class="fs-track" tabindex="0" aria-label="Scroll sideways for each piece">
                  {slidesOf(rooms).map((p, i) => (
                    <figure class:list={['fs-slide', { whole: p.bg }]} data-room={p.c.slug} data-item={p.name || undefined} style={p.bg ? `background:${p.bg}` : undefined}>
                      <Picture src={p.src} sizes="(max-width: 1000px) 100vw, 60vw" alt={`${p.c.name} ${p.name || roomName(p.c).toLowerCase()}`} loading="lazy" />
                      <figcaption>{p.name || roomName(p.c)}<span aria-hidden="true">|</span>{p.c.name}</figcaption>
                    </figure>
                  ))}
                </div>
                {/* See-through button, top left of the picture: back up to the top of the landing page */}
                <a href="#top" class="fs-top" aria-label="Back to the top of the page" data-tip="Go up"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6"/></svg></a>
                {slidesOf(rooms).length > 1 && <>
                  <button type="button" class="fs-arrow prev" aria-label="Previous piece" data-tip="Previous">‹</button>
                  <button type="button" class="fs-arrow next" aria-label="Next piece" data-tip="Next">›</button>
                </>}
              </div>
            ) : <Ph label={`${rooms[0].name} render`} watermark />}
            {rooms.map((c, k) => (
              <div class="feat-body" data-room={c.slug} data-label={roomName(c)} hidden={k > 0 ? true : undefined}>
                <small>{roomLabel(c.room)}</small>
                <h3>{c.name}</h3>
                {c.description && <p>{c.description}</p>}
                <span class="feat-meta">
                  <span><i>Room</i>{itemRooms(c).join(', ') || (c.room === 'other' ? 'Collection' : c.room)}</span>
                  {pieceNames(c) && <span><i>Includes</i>{pieceNames(c)}</span>}
                </span>
                <a class="feat-more" href={`#cat-${c.slug}-title`}>Explore the collection</a>
              </div>
            ))}
          </div>
          <nav class="room-nav" aria-label={`${rooms[0].name} rooms`}>
            {rooms.length > 1 && <button type="button" class="room-arrow prev" aria-label="Previous room">‹</button>}
            <span class="room-now"><span class="room-label">{rooms[0].name} · {roomName(rooms[0])}</span>{rooms.length > 1 && <small><span class="room-at">1</span> / {rooms.length}</small>}</span>
            {rooms.length > 1 && <button type="button" class="room-arrow next" aria-label="Next room">›</button>}
            {groups.length > 1 && <>
              <button type="button" class="coll-jump prev">Previous collection</button>
              <button type="button" class="coll-jump next">Next collection</button>
            </>}
          </nav>
          {rooms.map((c, k) => (
            <div class="room-cat" data-room={c.slug} hidden={k > 0 ? true : undefined}>
              <ItemCatalog collection={c} only={homeItems[c.slug]} link={false} />
            </div>
          ))}
          </div>
        ))}
      </div>
    ) : (
      <p class="coll-intro">First collections arrive soon.</p>
    )}
  </section>

  <!-- 6. Materials -->
  {showSection.home.materials && (
  <section class="section alt">
    <div class="tiles-head">
      <div><p class="eyebrow">Materials and finishes</p><h2>Built to be used, made to last.</h2></div>
    </div>
    <ul class="tiles">
      {materials.map(([n, d]) => (
        <li>
          <div class="tile">
            <Ph label={`${n} detail`} />
            <div class="cap"><h3>{n}</h3><small style="margin-top:6px;text-transform:none;letter-spacing:0;font-size:16px">{d}</small></div>
          </div>
        </li>
      ))}
    </ul>
  </section>
  )}

  <!-- 7. Journal -->
  {posts.length > 0 && (
    <section class="section">
      <div class="tiles-head"><div><h2>Insights</h2></div><a class="link" style="margin:0" href="/insights">All articles</a></div>
      <div class="journal">
        {posts.map((p) => (
          <a href={`/insights/${p.id}`}>
            <time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h3>{p.data.title}</h3><p>{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 8. For buyers (dark split) -->
  {showSection.home.forBuyers && (
  <section class="section dark">
    <div class="split">
      <div>
        <p class="eyebrow">For buyers</p>
        <h2>Mix collections in one container.</h2>
        <p class="text">For retailers, buying groups and distributors. Regional exclusivity is available and agreed case by case.</p>
        <div class="btns">
          <a class="btn" href="/how-a-container-works">How a container works</a>
          <a class="btn ghost" href="/partner-with-us">Partner with us</a>
        </div>
      </div>
      <div class="media"><Ph label="Container load" /></div>
    </div>
  </section>
  )}

  <!-- 9. Visit -->
  {showSection.home.visit && (
  <section class="section">
    <div class="split right">
      <div class="media"><Ph label="Showroom" /></div>
      <div>
        <p class="eyebrow">Visit us</p>
        <h2>See, sit and feel the range.</h2>
        <p class="text">Our showroom is the Jepara studio. Visits are by appointment.</p>
        <div class="btns"><a class="btn" href="/contact">Book a visit</a></div>
      </div>
    </div>
  </section>
  )}

  <!-- 10. Closing call to action -->
  <CtaBand />
</Base>

<script>
  import { followHint } from '../lib/hint';
  import { preload, prefer, imgJob, urlJob } from '../lib/preload';
  // #collections lands on the collection card (the room panel showing now, its top clear of the sticky header), not on
  // the section's heading above it (user, 6 Nov 2026): on load with the hash, and from any link to it on this page
  const toCard = () => document.querySelector('.room-panel:not([hidden]) .feat-card')?.scrollIntoView({ block: 'start' });
  // After load: the browser's own jump to the section comes late and would undo an earlier one
  if (location.hash === '#collections') addEventListener('load', () => setTimeout(toCard, 0));
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href$="#collections"]');
    if (!a || a.pathname !== location.pathname) return;
    e.preventDefault();
    history.replaceState(null, '', '#collections');
    toCard();
  });
  // Collections: one panel (room shot slider + copy + items) per collection at a time. The slider runs through every room
  // of the collection (Doheny bedroom, then Doheny living); the room of the slide on show leads the rest: its copy, the
  // room label, its items below (the piece on the slide marked), and the hero. The other way round, a hero picture shows
  // its collection here, at the first slide of its room. The room arrows jump the slider to the next room's first slide.
  // A link to #coll-<slug> or #cat-<slug>-title opens that room.
  document.querySelectorAll<HTMLElement>('.room-panels').forEach((box) => {
    const panels = [...box.querySelectorAll<HTMLElement>('.room-panel')];
    let cur = 0;
    const slidesIn = (p: HTMLElement) => [...p.querySelectorAll<HTMLElement>('.fs-slide')];
    const roomsIn = (p: HTMLElement) => [...p.querySelectorAll<HTMLElement>('.feat-body')].map((b) => b.dataset.room!);
    const tell = (p: HTMLElement) =>
      document.dispatchEvent(new CustomEvent('coll-room', { detail: { slug: p.dataset.room, name: p.dataset.name } }));
    // Show one room of a panel: its copy, label and items, with the piece on the slide marked in the items
    const setRoom = (p: HTMLElement, slug: string, item?: string) => {
      p.dataset.room = slug;
      p.querySelectorAll<HTMLElement>('.feat-body, .room-cat').forEach((el) => { el.hidden = el.dataset.room !== slug; });
      const rooms = roomsIn(p);
      const label = p.querySelector<HTMLElement>(`.feat-body[data-room="${CSS.escape(slug)}"]`)?.dataset.label;
      p.querySelector('.room-label')!.textContent = `${p.dataset.name} · ${label}`;
      const at = p.querySelector('.room-at');
      if (at) at.textContent = String(rooms.indexOf(slug) + 1);
      p.querySelectorAll<HTMLElement>('.cat-item').forEach((li) => {
        li.classList.toggle('is-now', !!item && li.dataset.name === item && li.closest<HTMLElement>('.room-cat')?.dataset.room === slug);
      });
    };
    // Move a panel's slider to a slide without animation (the room is set first, so the scroll that follows tells no one)
    const jumpTo = (p: HTMLElement, i: number) => {
      const track = p.querySelector<HTMLElement>('.fs-track');
      if (track && i >= 0) track.scrollTo({ left: i * track.clientWidth, behavior: 'auto' });
    };
    // Open a panel at a room (its first room when none is named); told: the hero follows
    const show = (i: number, slug?: string, told = true) => {
      cur = i;
      prefer(`panel:${i}`);
      panels.forEach((p, j) => { p.hidden = j !== cur; });
      const p = panels[cur];
      const room = slug ?? roomsIn(p)[0];
      const at = slidesIn(p).findIndex((s) => s.dataset.room === room);
      setRoom(p, room, slidesIn(p)[at]?.dataset.item);
      jumpTo(p, at);
      if (told) tell(p);
    };
    // The slide on show leads: once a scroll settles, a slide in another room switches the room (and the hero)
    panels.forEach((p) => {
      const track = p.querySelector<HTMLElement>('.fs-track');
      const slides = slidesIn(p);
      if (!track || !slides.length) return;
      let timer = 0;
      track.addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          const s = slides[Math.round(track.scrollLeft / Math.max(track.clientWidth, 1))];
          if (!s || p.hidden) return;
          const moved = s.dataset.room !== p.dataset.room;
          setRoom(p, s.dataset.room!, s.dataset.item);
          if (moved) tell(p);
        }, 120);
      }, { passive: true });
      setRoom(p, slides[0].dataset.room!, slides[0].dataset.item);
    });
    // Room arrows: the next or previous room's first slide, round from the last room to the first
    const step = (by: number) => {
      const p = panels[cur];
      const rooms = roomsIn(p);
      const slug = rooms[(rooms.indexOf(p.dataset.room!) + by + rooms.length) % rooms.length];
      const at = slidesIn(p).findIndex((s) => s.dataset.room === slug);
      setRoom(p, slug, slidesIn(p)[at]?.dataset.item);
      jumpTo(p, at);
      tell(p);
    };
    // Background loading (lib/preload), so every collection opens with its pictures there: the panel on show first (its
    // first four room shots, then each item's card photo), then the other collections, then the viewer's photos.
    // A panel scrolled into view, pointed at or opened moves ahead.
    panels.forEach((p, n) => {
      const g = `panel:${n}`;
      const on = !p.hidden;
      p.querySelectorAll<HTMLImageElement>('.fs-slide img').forEach((img, i) => preload(`img:${img.src}`, g, i < 4 ? (on ? 1 : 3) : 4, imgJob(img)));
      p.querySelectorAll<HTMLLIElement>('.cat-item').forEach((li) => {
        const img = li.querySelector<HTMLImageElement>('.cat-card img');
        if (img) preload(`card:${img.src}`, g, on ? 2 : 3, imgJob(img));
        const fill = li.querySelector<HTMLElement>('.edge-fill')?.dataset.fill;
        if (fill) preload(`url:${fill}`, g, on ? 2 : 3, urlJob(fill));
        const photos: string[] = [...JSON.parse(li.dataset.srcs ?? '[]'), ...Object.values(JSON.parse(li.dataset.photos ?? '{}') as Record<string, string[]>).flat()];
        photos.forEach((u) => preload(`url:${u}`, g, 4, urlJob(u)));
      });
      new IntersectionObserver((seen) => { if (seen.some((e) => e.isIntersecting)) prefer(g); }).observe(p);
      p.addEventListener('pointerenter', () => prefer(g));
    });
    box.querySelectorAll('.room-arrow.prev').forEach((b) => b.addEventListener('click', () => step(-1)));
    box.querySelectorAll('.room-arrow.next').forEach((b) => b.addEventListener('click', () => step(1)));
    // "Next collection" (right corner of the room row) and "Previous collection" (left corner) open the
    // next or previous collection at its first room, in page order, round at either end
    const jump = (by: number) => {
      show((cur + by + panels.length) % panels.length);
      // back up to the new collection's room card, so the visitor starts it from the top (the card clears the sticky header)
      panels[cur].querySelector('.feat-card')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    };
    box.querySelectorAll('.coll-jump.prev').forEach((b) => b.addEventListener('click', () => jump(-1)));
    box.querySelectorAll('.coll-jump.next').forEach((b) => b.addEventListener('click', () => jump(1)));
    // #coll-<slug> scrolls to the collection card at that room, #cat-<slug>-title ("Explore the collection") to its items
    const fromHash = () => {
      const m = location.hash.match(/^#(coll|cat)-([\w-]+?)(?:-title)?$/);
      if (!m) return;
      const i = panels.findIndex((p) => roomsIn(p).includes(m[2]));
      if (i < 0) return;
      show(i, m[2]);
      const target = m[1] === 'cat' ? document.getElementById(`cat-${m[2]}-title`) : panels[i].querySelector('.feat-card');
      target?.scrollIntoView({ block: 'start' });
    };
    fromHash();
    addEventListener('hashchange', fromHash);
    // The hero leads: when it moves to a room shot (#coll-doheny-living), this section shows that room of the collection
    document.addEventListener('hero-slide', (e) => {
      const slug = ((e as CustomEvent<{ href: string | null }>).detail.href ?? '').replace(/^.*(#coll-|\/)/, '');
      const i = panels.findIndex((p) => slug && roomsIn(p).includes(slug));
      if (i >= 0) show(i, slug, false);
    });
  });

  // Collection card picture: one slide per piece. Swipe or scroll sideways, use the arrows, or click the left or right
  // half of the picture. It moves only when asked (no autoplay, user 6 Nov 2026).
  document.querySelectorAll<HTMLElement>('.feat-slides').forEach((box) => {
    const track = box.querySelector<HTMLElement>('.fs-track')!;
    const prev = box.querySelector<HTMLButtonElement>('.prev');
    const next = box.querySelector<HTMLButtonElement>('.next');
    const n = track.children.length;
    if (n < 2 || !prev || !next) return; // one room shot: nothing to slide
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const at = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
    // Past either end it wraps round (first <-> last) in one step, without sliding back over every picture between
    const go = (i: number) => {
      const wrap = i < 0 || i >= n;
      track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior: still.matches || wrap ? 'auto' : 'smooth' });
    };
    prev.addEventListener('click', () => go(at() - 1));
    next.addEventListener('click', () => go(at() + 1));
    // Invisible buttons on the picture, as in the hero and the picture viewer: the left half goes back, the right half forward
    const back = (x: number) => { const r = track.getBoundingClientRect(); return x < r.left + r.width / 2; };
    track.addEventListener('click', (e) => go(at() + (back(e.clientX) ? -1 : 1)));
    track.addEventListener('mousemove', (e) => {
      const b = back(e.clientX);
      track.classList.toggle('to-prev', b);
      track.classList.toggle('to-next', !b);
    });
    followHint(track, (e) => (back(e.clientX) ? 'Previous' : 'Next'));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(at() - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(at() + 1); }
    });
  });
</script>
