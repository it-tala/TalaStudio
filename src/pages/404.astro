---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found"
  description="This page isn't here. Try the TalaStudio collections or request the catalog."
>
  <section class="section">
    <div class="wrap fade">
      <p class="eyebrow">404</p>
      <h1>This page isn't here.</h1>
      <p class="lede">It may have moved. Try the collections or request the catalog.</p>
      <div class="btns" style="margin-top:2rem">
        <a class="btn" href="/collections">View collections</a>
        <a class="btn ghost" href="/request-catalog">Request catalog</a>
      </div>
    </div>
  </section>
</Base>
