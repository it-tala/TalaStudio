---
import Base from '../layouts/Base.astro';
import Ph from '../components/Ph.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

// Drop workshop-floor.(jpg|png|webp) and showroom.(jpg|png|webp) into public/studio/. Placeholder shows until the file exists.
const studioImage = (name: string) => {
  const ext = ['jpg', 'jpeg', 'png', 'webp'].find((e) => existsSync(join(process.cwd(), 'public', 'studio', `${name}.${e}`)));
  return ext ? `/studio/${name}.${ext}` : null;
};
const workshop = studioImage('workshop-floor');
const showroom = studioImage('showroom');

const points = [
  ['Design', 'Collections are drawn here, by our own studio.'],
  ['Engineering', 'Joints, finishes and cartons are worked out while we design, not after.'],
  ['Costing', 'We cost each piece as it takes shape, so there are no surprises later.'],
  ['Inspection', 'Every piece is checked before it is packed and shipped.'],
];
---
<Base
  title="The Studio, Jepara"
  description="TalaStudio's design studio and showroom in Jepara, Indonesia. See how we design, engineer and check every piece, and book a visit."
>
  <section class="section dark">
    <div class="wrap fade">
      <p class="eyebrow">Jepara, Central Java</p>
      <h1>Our design studio, in Jepara.</h1>
      <p class="lede">This is where we draw, engineer and cost every collection. Design, engineering and costing happen in one place, so you get the forward look at a value price.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {workshop ? <img class="studio-img wide" src={workshop} alt="TalaStudio workshop floor" loading="lazy" /> : <Ph label="Studio shot: workshop floor" wide />}
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>One room, four jobs.</h2>
      <div class="pts">
        {points.map(([t, d]) => <div><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow">The showroom</p>
        <h2>See, sit and feel the range.</h2>
        <p class="lede">Our showroom is in the studio. Visits are by appointment, so we can walk you through the collections at your pace.</p>
        <a class="btn" href="/contact" style="margin-top:2rem">Book a visit</a>
      </div>
      {showroom ? <img class="studio-img" src={showroom} alt="TalaStudio showroom" loading="lazy" /> : <Ph label="Showroom" />}
    </div>
  </section>
</Base>

<style>
  .pts { display: grid; gap: 2.5rem; margin-top: 3rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .pts p { color: var(--text-soft); margin-top: .6rem; }
</style>

<style>
  .studio-img { display: block; width: 100%; height: auto; }
  .studio-img.wide { aspect-ratio: 16 / 9; object-fit: cover; }
</style>
