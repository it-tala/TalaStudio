---
import Base from '../layouts/Base.astro';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Base
  title="Request the catalog"
  description="Request the TalaStudio catalog: the full bedroom, living and dining range, with sizes, materials and container data."
>
  <section class="section">
    <div class="wrap grid-2" style="align-items:start">
      <div>
        <p class="eyebrow">Catalog</p>
        <h1>Request the catalog.</h1>
        <p class="lede">The full range, with sizes, materials, finishes and container data. For retailers, buying groups and distributors.</p>
      </div>
      <form id="f" method="post" action="/api/catalog">
        <label>Full name<input name="full_name" required autocomplete="name" /></label>
        <label>Company<input name="company" required autocomplete="organization" /></label>
        <label>Country<input name="country" required autocomplete="country-name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
        <label>Phone<input name="phone" type="tel" autocomplete="tel" /></label>
        <label>Buyer type
          <select name="buyer_type" required>
            <option value="">Select</option>
            <option>Retailer</option>
            <option>Buying group</option>
            <option>Distributor</option>
            <option>Other</option>
          </select>
        </label>
        <label>Message<textarea name="message" rows="4"></textarea></label>
        <input name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        {siteKey && <div class="cf-turnstile" data-sitekey={siteKey}></div>}
        <p class="note">By sending this you agree to our <a href="/privacy-and-terms">privacy policy</a>.</p>
        <button class="btn" type="submit">Send request</button>
        <p id="msg" role="status"></p>
      </form>
    </div>
  </section>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>

<script>
  const f = document.getElementById('f') as HTMLFormElement;
  const msg = document.getElementById('msg')!;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.textContent = 'Sending...';
    try {
      const r = await fetch(f.action, { method: 'POST', body: new FormData(f) });
      if (!r.ok) throw new Error();
      f.reset();
      msg.textContent = 'Thank you. We will send the catalog shortly.';
    } catch {
      msg.textContent = 'Something went wrong. Please email hello@talastudio.net.';
    }
  });
</script>

<style>
  form { display: grid; gap: 1.2rem; }
  label { display: grid; gap: .4rem; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-soft); }
  input, select, textarea { font: inherit; font-size: 1rem; letter-spacing: 0; text-transform: none; padding: .8rem; background: transparent; color: var(--text); border: 1px solid var(--line); border-radius: 0; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .hp { position: absolute; left: -9999px; }
  .note { font-size: .85rem; color: var(--text-soft); }
  #msg { min-height: 1.5rem; }
</style>
