---
import Base from '../../layouts/Base.astro';
import Ph from '../../components/Ph.astro';
import CtaBand from '../../components/CtaBand.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollections, getProducts, getProductImages, imageUrl } from '../../lib/supabase';

export async function getStaticPaths() {
  const [collections, products, images] = await Promise.all([getCollections(), getProducts(), getProductImages()]);
  return collections.map((collection) => {
    const pieces = products
      .filter((p) => p.collection_id === collection.id)
      .map((p) => ({ ...p, image: imageUrl(images.find((i) => i.product_id === p.id)?.image_path) }));
    return { params: { slug: collection.slug }, props: { collection, pieces } };
  });
}

import { edgeBackground } from '../../lib/edge';
const { collection } = Astro.props;
const gallery = await Promise.all((collection.gallery ?? []).map(async (g) => ({ ...g, bg: await edgeBackground(g.src) })));
const pieces = await Promise.all(Astro.props.pieces.map(async (p) => ({ ...p, bg: p.image ? await edgeBackground(p.image) : null })));
// The line under an item's name in the catalog: finish, then materials (or the SKU when neither is filled in).
const caption = (p: (typeof pieces)[number]) => [...(p.finishes ?? []), ...(p.materials ?? [])].join(' · ') || p.sku;
const hero = imageUrl(collection.hero_image_path);
const materials = [...new Set(pieces.flatMap((p) => p.materials ?? []))];
const finishes = [...new Set(pieces.flatMap((p) => p.finishes ?? []))];
---
<Base
  title={collection.name}
  description={`${collection.name}: a TalaStudio ${collection.room === 'other' ? '' : collection.room + ' '}collection, designed and engineered in Jepara. ${collection.description ?? ''}`.slice(0, 155)}
  image={hero ?? undefined}
>
  <section class="hero dark">
    {hero ? <img src={hero} alt={`${collection.name} collection${collection.room === 'other' ? '' : ', ' + collection.room} render`} /> : <Ph label={`${collection.name} hero render`} wide watermark />}
    <div class="wrap over fade">
      <p class="eyebrow">{collection.room === 'other' ? 'Collection' : `${collection.room} collection`}</p>
      <h1>{collection.name}</h1>
    </div>
  </section>

  {collection.description && (
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">The collection</p>
      <p class="intro">{collection.description}</p>
    </div>
  </section>
  )}

  {(pieces.length > 0 || gallery.length > 0) && (
    <section class="section">
      <div class="wrap">
        <h2>The {collection.name} collection</h2>
        {/* One catalog grid: items (each with its own page) first, then the gallery views (open in the zoom viewer). */}
        <ul class="catalog">
          {pieces.map((p) => (
            <li>
              <a class="piece" href={`/products/${p.slug}`}>
                <span class="frame" style={p.bg ? `background:${p.bg}` : undefined}>
                  {p.image ? <img src={p.image} alt={`${collection.name} ${p.name}`} loading="lazy" /> : <Ph label={p.name} watermark />}
                </span>
                <h3>{p.name}</h3>
                {caption(p) && <p class="meta">{caption(p)}</p>}
                <span class="link">View details</span>
              </a>
            </li>
          ))}
          {gallery.map((g, i) => (
            <li>
              <button type="button" class="piece zoom-open" data-index={i} aria-label={`Zoom in${g.name ? ': ' + g.name : ''}`}>
                <span class="frame" style={g.bg ? `background:${g.bg}` : undefined}>
                  <img src={g.src} alt={g.name ? `${collection.name} ${g.name}` : `${collection.name} collection, view ${i + 1}`} loading={i < 2 ? 'eager' : 'lazy'} />
                </span>
                {g.name && <h3>{g.name}</h3>}
                {g.note && <p class="meta">{g.note}</p>}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {gallery.length > 0 && <Lightbox />}

  {(materials.length > 0 || finishes.length > 0) && (
    <section class="section">
      <div class="wrap mats">
        {materials.length > 0 && <div><h3>Materials</h3><ul>{materials.map((m) => <li>{m}</li>)}</ul></div>}
        {finishes.length > 0 && <div><h3>Finishes</h3><ul>{finishes.map((f) => <li>{f}</li>)}</ul></div>}
      </div>
    </section>
  )}

  <CtaBand title={`The full ${collection.name} range is in the catalog.`} />
</Base>

<script>
  import { openLightbox } from '../../lib/lightbox';
  // Gallery views open in the zoom viewer, starting at the one clicked.
  const zooms = [...document.querySelectorAll<HTMLButtonElement>('.zoom-open')];
  const photos = zooms.map((b) => {
    const im = b.querySelector('img')!;
    return { src: im.getAttribute('src')!, alt: im.alt, caption: b.querySelector('h3')?.textContent ?? '' };
  });
  zooms.forEach((b, i) => b.addEventListener('click', () => openLightbox(photos, i)));
</script>

<style>
  .hero { position: relative; }
  .hero :global(.ph), .hero img { aspect-ratio: 21 / 9; width: 100%; object-fit: cover; min-height: 22rem; }
  .over { position: absolute; inset: auto 0 2.5rem 0; margin-inline: auto; }
  .intro { font: 400 clamp(1.5rem, 3vw, 2.2rem)/1.35 'Cormorant Garamond', Georgia, serif; max-width: 48rem; }
  .mats { display: grid; gap: 3rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .mats ul { list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: .4rem; color: var(--text-soft); }
</style>

<style>
  /* Catalog grid: image, name, and "View details" for items that have their own page */
  .catalog { list-style: none; padding: 0; display: grid; gap: 2.5rem 1.25rem; margin-top: 2.5rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); align-items: start; }
  .piece { display: block; width: 100%; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; text-decoration: none; }
  .piece h3 { margin-top: 1rem; font-size: 1.35rem; }
  .piece .meta { margin-top: .25rem; color: var(--text-soft); font-size: .9rem; line-height: 1.5; }
  .piece .link { margin-top: .6rem; font-size: .75rem; }
  .zoom-open { cursor: zoom-in; }
</style>
