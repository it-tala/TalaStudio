---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Ph from '../components/Ph.astro';
import CtaBand from '../components/CtaBand.astro';
import { story } from '../data/story';

const team = [
  ['Evin', 'Owner and designer'],
  ['David', 'Sales and buyer relations'],
];
---
<Base
  title="About"
  description="TalaStudio designs furniture where it is made, in Jepara, Indonesia: the forward look at a value price, every piece checked, fully online."
>
  <PageHero eyebrow="About" title={story.title} lede={story.promise} />

  <section class="section">
    <div class="wrap grid-2" style="align-items:start">
      <Ph label="Studio shot" />
      <div class="prose">
        <h2>Our story</h2>
        {story.paragraphs.map((p) => <p>{p}</p>)}
        <p class="close">{story.close}</p>
        <a class="btn" href="/request-catalog" style="margin-top:1.5rem">Request catalog</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>What you can count on</h2>
      <div class="counts">
        {story.counts.map(([t, d]) => <div><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>The team</h2>
      <div class="team">
        {team.map(([n, r]) => <div><h3>{n}</h3><p>{r}</p></div>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .prose p { margin-top: 1rem; font-size: 1.15rem; color: var(--text-soft); max-width: 40rem; }
  .prose h2 { margin-bottom: .4rem; }
  .prose .close { color: var(--text); font: 500 1.7rem/1.25 'Cormorant Garamond', Georgia, serif; margin-top: 1.8rem; }
  .counts, .team { display: grid; gap: 2rem; margin-top: 2rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .counts > div, .team > div { border-top: 1px solid var(--line); padding-top: 1rem; }
  .counts p, .team p { color: var(--text-soft); margin-top: .4rem; }
</style>
