---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact"
  description="Talk to TalaStudio about container orders, regional exclusivity or a showroom visit in Jepara, Indonesia."
>
  <section class="section">
    <div class="wrap grid-2" style="align-items:start">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Talk to us.</h1>
        <p class="lede">Container orders, exclusivity, or a visit to the studio. We reply within one working day.</p>
      </div>
      <div class="cards">
        <div>
          <h3>Email</h3>
          <p><a href="mailto:hello@talastudio.net">hello@talastudio.net</a></p>
        </div>
        <div>
          <h3>Showroom visit</h3>
          <p>Jepara, Central Java, Indonesia. By appointment. Email us with your dates and we will confirm.</p>
        </div>
        <div>
          <h3>Want the catalog?</h3>
          <p><a href="/request-catalog">Request it here.</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .cards { display: grid; gap: 2rem; }
  .cards > div { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .cards p { color: var(--text-soft); margin-top: .4rem; }
</style>
